# ============================================================
# PUSAP - Mesa de Entrada Virtual
# Copiá este archivo a .env y completá los valores reales.
# NUNCA subas .env al repositorio.
# ============================================================

# Puerto del servidor
PORT=3000

# Secreto de sesión (mínimo 32 caracteres aleatorios)
SESSION_SECRET=cambia_esto_por_una_cadena_larga_y_aleatoria

# Entorno: development | production
NODE_ENV=development

# URL base pública (usada en emails y QR)
BASE_URL=http://localhost:3000

# SMTP (opcional: si no se configura, se usa Ethereal para dev)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Mesa de Entrada PUSAP" <no-reply@pusap.edu.ar>
