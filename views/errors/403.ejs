<%- include('../partials/header') %>
<div class="min-h-[60vh] flex items-center justify-center px-4">
    <div class="text-center bg-white p-12 rounded-2xl shadow-sm border border-slate-200 max-w-md w-full">
        <div class="w-16 h-16 bg-red-100 rounded-2xl flex items-center justify-center mx-auto mb-4">
            <i class="fa-solid fa-ban text-red-600 text-2xl"></i>
        </div>
        <h1 class="text-xl font-bold text-slate-900 mb-2">Acceso denegado</h1>
        <p class="text-slate-500 text-sm mb-6">No tenés permisos para acceder a esta sección.</p>
        <% const destino = user && user.role === 'alumno' ? '/alumno' : (user ? '/backoffice' : '/'); %>
        <a href="<%= destino %>" class="inline-flex items-center gap-2 bg-blue-700 text-white font-bold py-2.5 px-6 rounded-xl text-sm hover:bg-blue-800 transition">
            <i class="fa-solid fa-arrow-left"></i>
            Volver al inicio
        </a>
    </div>
</div>
<%- include('../partials/footer') %>
