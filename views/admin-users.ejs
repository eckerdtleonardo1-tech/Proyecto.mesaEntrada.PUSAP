<%- include('partials/header') %>

<div class="max-w-5xl mx-auto space-y-6">
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-slate-900 flex items-center gap-2">
            <i class="fa-solid fa-users-gear text-blue-700"></i>
            Gestión de Usuarios
        </h1>
        <p class="text-slate-500 text-sm mt-1">Administrá el personal autorizado y sus roles en el sistema.</p>
    </div>

    <!-- Lista de Usuarios -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <table class="min-w-full">
            <thead class="bg-slate-50 border-b border-slate-200">
                <tr>
                    <th class="px-5 py-3.5 text-left text-xs font-bold text-slate-500 uppercase">Nombre</th>
                    <th class="px-5 py-3.5 text-left text-xs font-bold text-slate-500 uppercase">Usuario</th>
                    <th class="px-5 py-3.5 text-left text-xs font-bold text-slate-500 uppercase">Área</th>
                    <th class="px-5 py-3.5 text-left text-xs font-bold text-slate-500 uppercase">Rol</th>
                    <th class="px-5 py-3.5 text-right text-xs font-bold text-slate-500 uppercase">Acción</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                <% users.forEach(u => { %>
                <tr class="hover:bg-slate-50">
                    <td class="px-5 py-4 font-semibold text-sm text-slate-800"><%= u.name %></td>
                    <td class="px-5 py-4 text-sm text-slate-600"><%= u.username %></td>
                    <td class="px-5 py-4 text-sm text-slate-600"><%= u.area %></td>
                    <td class="px-5 py-4 text-sm">
                        <span class="px-2 py-1 bg-slate-100 rounded text-xs font-bold uppercase border border-slate-200 <%= u.role === 'operador' ? 'text-blue-700 bg-blue-50 border-blue-200' : 'text-slate-600' %>">
                            <%= u.role %>
                        </span>
                    </td>
                    <td class="px-5 py-4 text-right">
                        <% if(u.id !== user.id) { %>
                        <form action="/panel/usuarios/eliminar/<%= u.id %>" method="POST" onsubmit="return confirm('¿Eliminar usuario <%= u.username %>?')">
                            <button type="submit" class="text-red-500 hover:text-red-700"><i class="fa-solid fa-trash"></i></button>
                        </form>
                        <% } else { %>
                            <span class="text-slate-400 text-xs">Tú</span>
                        <% } %>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

    <!-- Nuevo Usuario -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
        <h3 class="font-bold text-slate-800 mb-4">Nuevo Usuario</h3>
        <form action="/panel/usuarios/nuevo" method="POST" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 items-end">
            <div>
                <label class="block text-xs font-bold text-slate-500 mb-1 uppercase">Nombre Completo</label>
                <input type="text" name="name" required class="w-full border border-slate-300 rounded-xl py-2 px-3 text-sm focus:ring-blue-500 outline-none">
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-500 mb-1 uppercase">Usuario</label>
                <input type="text" name="username" required class="w-full border border-slate-300 rounded-xl py-2 px-3 text-sm focus:ring-blue-500 outline-none">
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-500 mb-1 uppercase">Contraseña</label>
                <input type="text" name="password" required class="w-full border border-slate-300 rounded-xl py-2 px-3 text-sm focus:ring-blue-500 outline-none">
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-500 mb-1 uppercase">Área</label>
                <select name="area" required class="w-full border border-slate-300 rounded-xl py-2 px-3 text-sm focus:ring-blue-500 outline-none bg-white">
                    <% areas.forEach(a => { %>
                        <option value="<%= a.name %>"><%= a.name %></option>
                    <% }) %>
                </select>
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-500 mb-1 uppercase">Rol</label>
                <select name="role" class="w-full border border-slate-300 rounded-xl py-2 px-3 text-sm focus:ring-blue-500 outline-none bg-white">
                    <option value="interno">Interno (Solo su área)</option>
                    <option value="operador">Operador (Mesa Entrada)</option>
                </select>
            </div>
            <div class="lg:col-span-5 flex justify-end mt-2">
                <button type="submit" class="bg-blue-700 hover:bg-blue-800 text-white font-bold py-2 px-5 rounded-xl shadow-sm text-sm transition">
                    Crear Usuario
                </button>
            </div>
        </form>
    </div>
</div>

<%- include('partials/footer') %>
