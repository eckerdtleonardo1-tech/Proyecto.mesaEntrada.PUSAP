<%- include('partials/header') %>

<div class="flex items-center justify-center min-h-[60vh]">
    <div class="bg-white p-8 rounded-xl shadow-lg w-full max-w-md border-t-4 border-gray-800">
        <div class="text-center mb-6">
            <i class="fa-solid fa-user-shield text-4xl text-gray-800 mb-2"></i>
            <h2 class="text-2xl font-bold text-gray-900">Acceso Administrativo</h2>
            <p class="text-gray-500 text-sm mt-1">Ingreso exclusivo personal PUSAP</p>
        </div>

        <% if (error) { %>
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4 text-center text-sm" role="alert">
                <span class="block sm:inline"><i class="fa-solid fa-triangle-exclamation mr-1"></i> <%= error %></span>
            </div>
        <% } %>

        <form action="/login" method="POST" class="space-y-4">
            <div>
                <label for="username" class="block text-sm font-medium text-gray-700">Usuario</label>
                <div class="mt-1 relative rounded-md shadow-sm">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <i class="fa-solid fa-user text-gray-400"></i>
                    </div>
                    <input type="text" name="username" id="username" required class="focus:ring-gray-800 focus:border-gray-800 block w-full pl-10 px-4 py-2 sm:text-sm border-gray-300 rounded-md border">
                </div>
            </div>

            <div>
                <label for="password" class="block text-sm font-medium text-gray-700">Contraseña</label>
                <div class="mt-1 relative rounded-md shadow-sm">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <i class="fa-solid fa-lock text-gray-400"></i>
                    </div>
                    <input type="password" name="password" id="password" required class="focus:ring-gray-800 focus:border-gray-800 block w-full pl-10 px-4 py-2 sm:text-sm border-gray-300 rounded-md border">
                </div>
            </div>

            <div class="pt-2">
                <button type="submit" class="w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-gray-800 hover:bg-gray-900 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 transition">
                    Ingresar al Panel
                </button>
            </div>
        </form>
        
        <div class="mt-6 border-t border-gray-200 pt-4 text-center text-xs text-gray-400">
            <p>Datos de prueba: admin / puasap2024</p>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
