<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | PUSAP</title>
    
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#1e3a8a">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <script>if('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js');</script>
    
    <script>
        if(localStorage.getItem('darkMode') === 'true') document.documentElement.classList.add('dark');
    </script>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>tailwind.config = { darkMode: 'class' }</script>
    <link rel="stylesheet" href="/css/fontawesome.min.css" onerror="this.onerror=null;this.href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css'">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/driver.js@3.1.1/dist/driver.css" />
    <script src="https://cdn.jsdelivr.net/npm/driver.js@3.1.1/dist/driver.js.iife.js"></script>
    <style type="text/tailwindcss">
        [x-cloak] { display: none !important; }
        
        /* Base animations */
        .fade-in { animation: fadeIn 0.3s ease-in-out; }
        .slide-up { animation: slideUp 0.4s ease-out; }
        .scale-in { animation: scaleIn 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); }
        
        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
        @keyframes slideUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
        @keyframes scaleIn { from { opacity: 0; transform: scale(0.95); } to { opacity: 1; transform: scale(1); } }
        
        /* Sidebar and Nav links */
        .sidebar-link { @apply flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm font-medium transition-all duration-300; }
        .sidebar-link:hover { @apply bg-blue-700/50 text-white translate-x-1; }
        .sidebar-link.active { @apply bg-white/15 text-white font-bold border-l-4 border-blue-400; }
        
        .nav-link { @apply px-3 py-2 rounded-md text-sm font-medium hover:bg-blue-800 hover:text-white transition-all duration-300 relative overflow-hidden; }
        .nav-link::after { content: ''; position: absolute; bottom: 0; left: 50%; width: 0; height: 2px; background: white; transition: all 0.3s ease; transform: translateX(-50%); }
        .nav-link:hover::after { width: 80%; }
        
        /* Tooltip */
        .has-tooltip:hover .tooltip-content { opacity: 1; visibility: visible; transform: translateY(0); }
        .tooltip-content { opacity: 0; visibility: hidden; transform: translateY(5px); transition: all 0.2s ease; }
        
        /* Progress Bar Custom */
        .step-active .step-icon { @apply bg-blue-600 text-white border-blue-600 shadow-md shadow-blue-500/30 scale-110; }
        .step-completed .step-icon { @apply bg-green-500 text-white border-green-500; }
        .step-pending .step-icon { @apply bg-slate-100 text-slate-400 border-slate-200; }
        
        /* Mobile menu animation */
        #mobileMenu { transition: max-height 0.3s ease-in-out, opacity 0.3s ease-in-out; max-height: 0; opacity: 0; overflow: hidden; }
        #mobileMenu.open { max-height: 400px; opacity: 1; }
    </style>
</head>
<body class="bg-slate-50 flex flex-col min-h-screen font-sans text-slate-800">

<% if (user) { %>
<!-- ========== LAYOUT INTERNO (con sidebar) ========== -->
<div class="flex min-h-screen">

    <!-- Sidebar -->
    <aside class="w-64 bg-gradient-to-b from-blue-950 to-blue-900 text-white flex flex-col fixed inset-y-0 left-0 z-30 shadow-2xl hidden lg:flex">
        <!-- Logo -->
        <div class="flex items-center gap-3 px-6 py-5 border-b border-blue-800">
            <div class="w-9 h-9 bg-white/10 rounded-lg flex items-center justify-center">
                <i class="fa-solid fa-building-columns text-white text-lg"></i>
            </div>
            <div>
                <span class="font-bold text-lg text-white block leading-tight">PUSAP</span>
                <span class="text-blue-300 text-xs">Mesa de Entrada</span>
            </div>
        </div>

        <!-- User info -->
        <div class="px-4 py-4 border-b border-blue-800/60 mx-3 mt-3 bg-white/5 rounded-xl">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-full bg-blue-700 flex items-center justify-center font-bold text-sm flex-shrink-0">
                    <%= user.name.charAt(0).toUpperCase() %>
                </div>
                <div class="overflow-hidden">
                    <p class="text-sm font-bold text-white truncate"><%= user.name %></p>
                    <p class="text-xs text-blue-300 truncate"><%= user.area %></p>
                </div>
            </div>
            <div class="mt-2">
                <% if (user.role === 'operador') { %>
                    <span class="text-xs bg-green-500/20 text-green-300 border border-green-500/30 px-2 py-0.5 rounded-full font-medium">Operador Principal</span>
                <% } else { %>
                    <span class="text-xs bg-blue-500/20 text-blue-300 border border-blue-500/30 px-2 py-0.5 rounded-full font-medium">Área Interna</span>
                <% } %>
            </div>
        </div>

        <!-- Nav Links -->
        <nav class="flex-grow px-3 py-4 space-y-1" id="tour-sidebar">
            <p class="text-blue-400/70 text-xs font-bold uppercase tracking-widest px-4 mb-2">Gestión</p>
            <a href="/panel" class="sidebar-link text-blue-100">
                <i class="fa-solid fa-chart-pie w-4 text-center"></i>
                <span>Panel de Control</span>
            </a>
            <a href="/panel/mi-perfil" class="sidebar-link text-blue-100">
                <i class="fa-solid fa-user-circle w-4 text-center"></i>
                <span>Mi Perfil</span>
            </a>
            <% if (user.role === 'operador') { %>
            <a href="/panel/nuevo" id="tour-nuevo-tramite" class="sidebar-link text-blue-100">
                <i class="fa-solid fa-file-circle-plus w-4 text-center"></i>
                <span>Alta de Trámite</span>
            </a>
            <% } %>
            <% if (user.role === 'operador') { %>
            <div class="pt-3 mt-3 border-t border-blue-800/60">
                <p class="text-blue-400/70 text-xs font-bold uppercase tracking-widest px-4 mb-2">Administración</p>
                <a href="/panel/usuarios" class="sidebar-link text-blue-100">
                    <i class="fa-solid fa-users-gear w-4 text-center"></i>
                    <span>Gestión de Usuarios</span>
                </a>
                <a href="/panel/config" class="sidebar-link text-blue-100">
                    <i class="fa-solid fa-gears w-4 text-center"></i>
                    <span>Configuración</span>
                </a>
                <a href="/panel/auditoria" class="sidebar-link text-blue-100">
                    <i class="fa-solid fa-shield-halved w-4 text-center"></i>
                    <span>Auditoría</span>
                </a>
                <a href="/panel/papelera" class="sidebar-link text-blue-100">
                    <i class="fa-solid fa-trash-can w-4 text-center"></i>
                    <span>Papelera</span>
                </a>
            </div>
            <% } %>
            <div class="pt-3 mt-3 border-t border-blue-800/60">
                <p class="text-blue-400/70 text-xs font-bold uppercase tracking-widest px-4 mb-2">Portal Público</p>
                <a href="/" target="_blank" class="sidebar-link text-blue-100">
                    <i class="fa-solid fa-arrow-up-right-from-square w-4 text-center"></i>
                    <span>Ver Portal Web</span>
                </a>
            </div>
        </nav>

        <!-- Bottom logout and help -->
        <div class="px-3 py-4 border-t border-blue-800/60 flex flex-col gap-1">
            <button onclick="startTour()" class="sidebar-link text-blue-300 hover:bg-blue-600/30 hover:text-blue-200 w-full text-left">
                <i class="fa-solid fa-circle-question w-4 text-center"></i>
                <span>Ayuda / Repetir Tour</span>
            </button>
            <a href="/logout" class="sidebar-link text-red-300 hover:bg-red-600/30 hover:text-red-200 w-full">
                <i class="fa-solid fa-right-from-bracket w-4 text-center"></i>
                <span>Cerrar Sesión</span>
            </a>
        </div>
    </aside>

    <!-- Main content area -->
    <div class="flex-1 flex flex-col lg:ml-64 min-w-0">
        <!-- Top bar for mobile / header -->
        <header class="bg-white shadow-sm border-b border-slate-200 sticky top-0 z-20 dark:bg-slate-800 dark:border-slate-700">
            <div class="flex items-center justify-between px-4 sm:px-6 h-14">
                <!-- Mobile menu button -->
                <button id="sidebarToggle" class="lg:hidden text-slate-500 hover:text-blue-700 hover:bg-blue-50 p-3 rounded-md transition" onclick="document.getElementById('mobileSidebar').classList.toggle('hidden')">
                    <i class="fa-solid fa-bars text-lg"></i>
                </button>
                <div class="flex items-center gap-2 lg:hidden">
                    <i class="fa-solid fa-building-columns text-blue-900 text-lg"></i>
                    <span class="font-bold text-blue-900">PUSAP</span>
                </div>
                <!-- Right side: breadcrumb / title -->
                <div class="hidden lg:flex items-center gap-2 text-sm text-slate-500">
                    <i class="fa-solid fa-house text-slate-400"></i>
                    <span>/</span>
                    <span class="font-medium text-slate-700"><%= title %></span>
                </div>
                
                <div id="tour-search-qr" class="flex items-center gap-4 flex-grow justify-center lg:justify-start lg:ml-6 lg:flex-grow-0">
                    <form action="/panel" method="GET" class="relative hidden sm:block w-full max-w-xs">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <i class="fa-solid fa-magnifying-glass text-slate-400"></i>
                        </div>
                        <input type="text" name="search" placeholder="Buscar código, DNI..." class="w-full pl-9 pr-4 py-1.5 bg-slate-100 border border-slate-200 rounded-lg text-sm focus:bg-white focus:ring-2 focus:ring-blue-500 outline-none transition">
                    </form>
                    <button onclick="openQrScanner()" class="text-slate-500 hover:text-blue-700 bg-slate-100 dark:bg-slate-700 dark:text-slate-300 dark:hover:text-blue-400 p-2 rounded-lg transition" title="Escanear QR">
                        <i class="fa-solid fa-qrcode text-lg"></i>
                    </button>
                </div>
                <div class="flex items-center gap-3">
                    <span class="text-xs text-slate-400 hidden sm:block dark:text-slate-300"><%= new Date().toLocaleDateString('es-AR', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></span>
                    
                    <!-- Dark mode toggle -->
                    <button id="tour-theme" onclick="toggleDarkMode()" class="text-slate-500 hover:text-blue-700 dark:text-slate-400 dark:hover:text-blue-300">
                        <i class="fa-solid fa-moon" id="darkIcon"></i>
                    </button>
                    
                    <!-- Notifications -->
                    <div class="relative">
                        <button id="notifBtn" class="text-slate-500 hover:text-blue-700 dark:text-slate-400 dark:hover:text-blue-300 relative">
                            <i class="fa-solid fa-bell text-lg"></i>
                            <span id="notifBadge" class="absolute -top-1 -right-1 bg-red-500 text-white text-[10px] w-4 h-4 flex items-center justify-center rounded-full hidden">0</span>
                        </button>
                        <div id="notifDropdown" class="hidden absolute right-0 mt-2 w-72 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl shadow-lg z-50 overflow-hidden">
                            <div class="p-3 border-b border-slate-100 dark:border-slate-700 font-bold text-sm text-slate-800 dark:text-slate-100">
                                Actividad Reciente
                            </div>
                            <div id="notifList" class="max-h-64 overflow-y-auto">
                                <div class="p-4 text-xs text-slate-500 text-center">Cargando...</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <!-- Mobile Sidebar Overlay -->
        <div id="mobileSidebar" class="hidden fixed inset-0 z-40 lg:hidden fade-in">
            <div class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm" onclick="document.getElementById('mobileSidebar').classList.add('hidden')"></div>
            <aside class="absolute inset-y-0 left-0 w-64 bg-gradient-to-b from-blue-950 to-blue-900 text-white flex flex-col shadow-2xl h-full slide-up">
                <div class="flex items-center justify-between px-6 py-5 border-b border-blue-800">
                    <div class="flex items-center gap-3">
                        <i class="fa-solid fa-building-columns text-white text-lg"></i>
                        <span class="font-bold text-lg">PUSAP</span>
                    </div>
                    <button onclick="document.getElementById('mobileSidebar').classList.add('hidden')" class="text-blue-300 hover:text-white bg-white/10 w-8 h-8 rounded-lg flex items-center justify-center transition">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>
                <nav class="flex-grow px-3 py-4 space-y-1 overflow-y-auto">
                    <a href="/panel" class="sidebar-link text-blue-100 text-base py-3.5"><i class="fa-solid fa-chart-pie w-4"></i> Panel de Control</a>
                    <a href="/panel/mi-perfil" class="sidebar-link text-blue-100 text-base py-3.5"><i class="fa-solid fa-user-circle w-4"></i> Mi Perfil</a>
                    <% if (user.role === 'operador') { %>
                    <a href="/panel/nuevo" class="sidebar-link text-blue-100 text-base py-3.5"><i class="fa-solid fa-file-circle-plus w-4"></i> Alta de Trámite</a>
                    <% } %>
                    <a href="/" target="_blank" class="sidebar-link text-blue-100 text-base py-3.5"><i class="fa-solid fa-arrow-up-right-from-square w-4"></i> Portal Público</a>
                </nav>
                <div class="px-3 py-4 border-t border-blue-800/60">
                    <a href="/logout" class="sidebar-link text-red-300 hover:bg-red-600/30 w-full"><i class="fa-solid fa-right-from-bracket w-4"></i> Cerrar Sesión</a>
                </div>
            </aside>
        </div>

        <!-- Page Content -->
        <main class="flex-grow p-4 sm:p-6 lg:p-8 bg-slate-50 dark:bg-slate-900 relative">
        
        <% if (user.role === 'operador') { %>
        <!-- Floating Action Button for mobile -->
        <a href="/panel/nuevo" class="fixed bottom-6 right-6 w-14 h-14 bg-blue-600 hover:bg-blue-700 text-white rounded-full flex items-center justify-center shadow-lg md:hidden z-50 transition-transform transform hover:scale-105">
            <i class="fa-solid fa-plus text-2xl"></i>
        </a>
        <% } %>

        <!-- Modal QR Scanner -->
        <div id="qrModal" class="hidden fixed inset-0 z-50 flex items-center justify-center fade-in">
            <div class="absolute inset-0 bg-slate-900/80 backdrop-blur-sm" onclick="closeQrScanner()"></div>
            <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-2xl p-6 w-full max-w-md relative z-10 scale-in mx-4">
                <div class="flex justify-between items-center mb-4">
                    <h3 class="text-lg font-bold text-slate-800 dark:text-white"><i class="fa-solid fa-qrcode mr-2 text-blue-600"></i> Escanear Código QR</h3>
                    <button onclick="closeQrScanner()" class="text-slate-400 hover:text-red-500 transition">
                        <i class="fa-solid fa-xmark text-xl"></i>
                    </button>
                </div>
                <div id="qr-reader" class="w-full overflow-hidden rounded-lg border-2 border-slate-200 dark:border-slate-700 text-slate-800 dark:text-white"></div>
                <p class="text-xs text-center text-slate-500 mt-4">Apunta la cámara al código QR del comprobante.</p>
            </div>
        </div>

        <script src="https://unpkg.com/html5-qrcode"></script>
        <script>
            let html5QrcodeScanner = null;

            function openQrScanner() {
                document.getElementById('qrModal').classList.remove('hidden');
                
                if (!html5QrcodeScanner) {
                    html5QrcodeScanner = new Html5QrcodeScanner(
                        "qr-reader", { fps: 10, qrbox: {width: 250, height: 250} }, false);
                }
                
                html5QrcodeScanner.render(onScanSuccess, onScanFailure);
            }

            function closeQrScanner() {
                document.getElementById('qrModal').classList.add('hidden');
                if (html5QrcodeScanner) {
                    html5QrcodeScanner.clear().catch(error => {
                        console.error("Failed to clear scanner: ", error);
                    });
                }
            }

            function onScanSuccess(decodedText, decodedResult) {
                let code = decodedText;
                try {
                    let url = new URL(decodedText);
                    if (url.searchParams.has('codigo')) {
                        code = url.searchParams.get('codigo');
                    }
                } catch(e) {}
                
                closeQrScanner();
                window.location.href = "/panel?search=" + encodeURIComponent(code);
            }

            function onScanFailure(error) {}
        </script>

<script>
function toggleDarkMode() {
  const isDark = document.documentElement.classList.toggle('dark');
  localStorage.setItem('darkMode', isDark);
  document.getElementById('darkIcon').className = isDark ? 'fa-solid fa-sun' : 'fa-solid fa-moon';
}
document.addEventListener('DOMContentLoaded', () => {
  if(localStorage.getItem('darkMode') === 'true') {
    const icon = document.getElementById('darkIcon');
    if(icon) icon.className = 'fa-solid fa-sun';
  }
});
</script>

<script>
    let notifCache = [];
    let unreadCount = 0;

    async function fetchNotifs() {
        try {
            const res = await fetch('/panel/api/actividad-reciente');
            const data = await res.json();
            
            if (notifCache.length > 0) {
                const newItems = data.filter(d => !notifCache.find(c => c.ticket_id === d.ticket_id && c.created_at === d.created_at));
                if (newItems.length > 0) {
                    unreadCount += newItems.length;
                    const badge = document.getElementById('notifBadge');
                    badge.textContent = unreadCount;
                    badge.classList.remove('hidden');
                }
            }
            notifCache = data;
            
            const list = document.getElementById('notifList');
            if (data.length === 0) {
                list.innerHTML = '<div class="p-4 text-xs text-slate-500 text-center">No hay actividad reciente.</div>';
            } else {
                list.innerHTML = data.map(n => `
                    <a href="/panel/tramite/${n.ticket_id}" class="block p-3 border-b border-slate-50 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700 transition">
                        <div class="text-xs font-mono font-bold text-blue-600 dark:text-blue-400">${n.tracking_code}</div>
                        <div class="text-sm text-slate-800 dark:text-slate-200">${n.first_name} ${n.last_name}</div>
                        <div class="text-xs text-slate-500 mt-1">Cambió a: <span class="font-bold">${n.new_status}</span></div>
                    </a>
                `).join('');
            }
        } catch(e) {}
    }

    document.getElementById('notifBtn').addEventListener('click', () => {
        const drop = document.getElementById('notifDropdown');
        drop.classList.toggle('hidden');
        if (!drop.classList.contains('hidden')) {
            unreadCount = 0;
            document.getElementById('notifBadge').classList.add('hidden');
        }
    });

    fetchNotifs();
    setInterval(fetchNotifs, 30000);
</script>

<script>
    function startTour() {
        const driver = window.driver.js.driver;
        const steps = [
            {
                element: '#tour-search-qr',
                popover: {
                    title: 'Buscador y QR',
                    description: 'Desde acá podés buscar trámites por código, DNI o escanear el código QR del comprobante.',
                    side: 'bottom',
                    align: 'start'
                }
            },
            {
                element: '#tour-sidebar',
                popover: {
                    title: 'Menú de Navegación',
                    description: 'Acá encontrarás todas las opciones del sistema: gestionar trámites, configuración y auditoría.',
                    side: 'right',
                    align: 'start'
                }
            },
            {
                element: '#tour-theme',
                popover: {
                    title: 'Cambio de Tema',
                    description: 'Podés cambiar entre modo claro y oscuro desde este botón.',
                    side: 'bottom',
                    align: 'center'
                }
            },
            {
                element: '#notifBtn',
                popover: {
                    title: 'Notificaciones',
                    description: 'Revisá la actividad reciente y los cambios de estado en tus trámites.',
                    side: 'bottom',
                    align: 'end'
                }
            }
        ];

        if (document.getElementById('tour-nuevo-tramite')) {
            steps.splice(2, 0, {
                element: '#tour-nuevo-tramite',
                popover: {
                    title: 'Nuevo Trámite',
                    description: 'Acceso directo para dar de alta nuevos trámites rápidamente.',
                    side: 'right',
                    align: 'center'
                }
            });
        }

        const driverObj = driver({
            showProgress: true,
            nextBtnText: 'Siguiente',
            prevBtnText: 'Atrás',
            doneBtnText: 'Terminar',
            steps: steps,
            onDestroyStarted: () => {
                if (!driverObj.hasNextStep() || confirm("¿Seguro que querés salir del tour?")) {
                    driverObj.destroy();
                    localStorage.setItem('pusap_tour', 'done');
                }
            }
        });

        driverObj.drive();
    }

    document.addEventListener('DOMContentLoaded', () => {
        if (!localStorage.getItem('pusap_tour')) {
            setTimeout(() => {
                startTour();
            }, 500);
        }
    });
</script>

