                    <a href="/nuevo-tramite" class="flex items-center gap-3 px-4 py-3.5 text-blue-100 rounded-xl hover:bg-white/10 transition text-base font-medium"><div class="w-8 h-8 rounded-lg bg-blue-800 flex items-center justify-center"><i class="fa-solid fa-file-signature"></i></div>Iniciar Trámite</a>
                    <a href="/seguimiento" class="flex items-center gap-3 px-4 py-3.5 text-blue-100 rounded-xl hover:bg-white/10 transition text-base font-medium"><div class="w-8 h-8 rounded-lg bg-blue-800 flex items-center justify-center"><i class="fa-solid fa-magnifying-glass"></i></div>Ver mi Trámite</a>
