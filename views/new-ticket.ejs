<%- include('partials/header') %>

<div class="max-w-4xl mx-auto bg-white p-8 rounded-xl shadow-md border-t-4 border-blue-800">
    <h2 class="text-2xl font-bold text-gray-900 mb-6 border-b pb-2">
        <i class="fa-solid fa-file-circle-plus text-blue-600 mr-2"></i> Alta de Nuevo Trámite
    </h2>

    <form action="/panel/nuevo" method="POST" enctype="multipart/form-data" class="space-y-6">
        
        <!-- Datos del Solicitante -->
        <fieldset class="border p-4 rounded-md bg-gray-50">
            <legend class="text-lg font-semibold text-gray-700 px-2">Datos del Solicitante</legend>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-2">
                <div>
                    <label class="block text-sm font-medium text-gray-700">Nombre</label>
                    <input type="text" name="first_name" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700">Apellido</label>
                    <input type="text" name="last_name" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700">DNI</label>
                    <input type="text" name="dni" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700">CUIL</label>
                    <input type="text" name="cuil" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700">Teléfono</label>
                    <input type="text" name="phone" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700">Correo Electrónico (Notificaciones)</label>
                    <input type="email" name="email" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500">
                </div>
            </div>
        </fieldset>

        <!-- Datos del Trámite -->
        <fieldset class="border p-4 rounded-md bg-gray-50">
            <legend class="text-lg font-semibold text-gray-700 px-2">Datos del Trámite</legend>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-2">
                <div>
                    <label class="block text-sm font-medium text-gray-700">Tipo de Trámite</label>
                    <select name="category" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500">
                        <option value="Inscripción">Inscripción a Carrera</option>
                        <option value="Solicitud de Equivalencias">Solicitud de Equivalencias</option>
                        <option value="Pago / Aranceles">Pago / Aranceles</option>
                        <option value="Certificado de Alumno Regular">Certificado de Alumno Regular</option>
                        <option value="Presentación de Título">Presentación de Título (Constancia)</option>
                        <option value="Otros">Otros</option>
                    </select>
                </div>
                <div class="mt-4">
                    <label class="block text-sm font-medium text-gray-700">Fecha Límite / Vencimiento (Opcional)</label>
                    <input type="date" name="expiration_date" value="<%= moment().add(7, 'days').format('YYYY-MM-DD') %>" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 bg-white">
                    <p class="text-xs text-gray-500 mt-1">Por defecto se asigna 1 semana. Puedes modificarla o borrarla.</p>
                </div>
            </div>
        </fieldset>

        <!-- Documentación Adjunta -->
        <fieldset class="border p-4 rounded-md bg-gray-50">
            <legend class="text-lg font-semibold text-gray-700 px-2">Documentación</legend>
            <div class="mt-2">
                <label class="block text-sm font-medium text-gray-700 mb-2">Subir Archivos (PDF, JPG, PNG)</label>
                <input type="file" name="attachments" multiple class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100 border border-gray-300 rounded-md p-2 bg-white">
                <p class="text-xs text-gray-500 mt-2">Puede seleccionar varios archivos a la vez manteniendo presionada la tecla Ctrl/Cmd.</p>
            </div>
        </fieldset>

        <div class="flex justify-end pt-4">
            <a href="/panel" class="bg-gray-300 hover:bg-gray-400 text-gray-800 font-bold py-2 px-6 rounded mr-4 transition">Cancelar</a>
            <button type="submit" class="bg-blue-800 hover:bg-blue-900 text-white font-bold py-2 px-6 rounded shadow-md transition">
                <i class="fa-solid fa-save mr-2"></i> Guardar e Imprimir Talón
            </button>
        </div>
    </form>
</div>

<%- include('partials/footer') %>
