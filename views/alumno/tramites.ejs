<%- include('../partials/header') %>

<div class="max-w-5xl mx-auto px-4 sm:px-6 py-8">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
        <div>
            <h1 class="text-2xl font-black text-slate-800 flex items-center gap-2">
                <i class="fa-solid fa-receipt text-amber-600"></i> Mis Trámites en Mesa de Entrada
            </h1>
            <p class="text-xs text-slate-500 mt-1">Trámites iniciados y su estado general según tu DNI (<%= user.dni || 'Sin DNI asignado' %>)</p>
        </div>
        <a href="/nuevo-tramite" target="_blank" class="inline-flex items-center gap-2 bg-blue-700 hover:bg-blue-800 text-white font-bold px-4 py-2 rounded-xl text-xs transition self-start sm:self-auto">
            <i class="fa-solid fa-plus"></i> Iniciar Trámite Público
        </a>
    </div>

    <% if (tramites.length === 0) { %>
    <div class="bg-white rounded-2xl border border-slate-200 p-12 text-center shadow-sm">
        <div class="w-16 h-16 bg-amber-50 rounded-2xl flex items-center justify-center mx-auto mb-4 text-amber-600 text-2xl">
            <i class="fa-solid fa-folder-open"></i>
        </div>
        <h3 class="text-base font-bold text-slate-800 mb-1">No se registran trámites</h3>
        <p class="text-xs text-slate-500 max-w-sm mx-auto mb-4">No encontramos trámites ingresados con tu DNI en el sistema de Mesa de Entrada Virtual.</p>
        <a href="/nuevo-tramite" target="_blank" class="inline-flex items-center gap-2 text-xs font-bold text-blue-700 hover:underline">
            Ingresar un trámite ahora <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
        </a>
    </div>
    <% } else { %>
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead class="bg-slate-50 border-b border-slate-200 text-slate-600 text-xs uppercase font-bold tracking-wider">
                    <tr>
                        <th class="px-6 py-4">Código / Fecha</th>
                        <th class="px-6 py-4">Tipo de Trámite</th>
                        <th class="px-6 py-4">Área Actual</th>
                        <th class="px-6 py-4">Estado</th>
                        <th class="px-6 py-4 text-right">Comprobante</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    <% tramites.forEach(t => { 
                        const statusColors = {
                            'Iniciado': 'bg-blue-50 text-blue-700 border-blue-200',
                            'En Revisión': 'bg-purple-50 text-purple-700 border-purple-200',
                            'Pendiente de Documentación': 'bg-amber-50 text-amber-700 border-amber-200',
                            'Aprobado': 'bg-emerald-50 text-emerald-700 border-emerald-200',
                            'Rechazado': 'bg-red-50 text-red-700 border-red-200'
                        };
                    %>
                    <tr class="hover:bg-slate-50 transition">
                        <td class="px-6 py-4">
                            <span class="font-mono font-bold text-blue-700 block text-xs"><%= t.tracking_code %></span>
                            <span class="text-[11px] text-slate-400"><%= moment(t.created_at).format('DD/MM/YYYY HH:mm') %> hs</span>
                        </td>
                        <td class="px-6 py-4 font-semibold text-slate-800 text-xs"><%= t.category %></td>
                        <td class="px-6 py-4 text-xs text-slate-600"><%= t.area %></td>
                        <td class="px-6 py-4">
                            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-bold border <%= statusColors[t.status] || 'bg-slate-100 text-slate-700 border-slate-200' %>">
                                <%= t.status %>
                            </span>
                        </td>
                        <td class="px-6 py-4 text-right">
                            <a href="/comprobante/<%= t.tracking_code %>" target="_blank" class="inline-flex items-center gap-1.5 text-xs font-bold text-slate-700 hover:text-blue-700 bg-slate-100 hover:bg-slate-200 px-3 py-1.5 rounded-lg transition" title="Descargar comprobante en PDF">
                                <i class="fa-solid fa-file-pdf text-red-500"></i> PDF
                            </a>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
    <% } %>
</div>

<%- include('../partials/footer') %>
