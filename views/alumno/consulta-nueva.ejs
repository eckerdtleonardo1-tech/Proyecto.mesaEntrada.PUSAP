<%- include('../partials/header') %>

<div class="max-w-2xl mx-auto px-4 sm:px-6 py-8">
    <a href="/alumno/consultas" class="text-sm font-semibold text-blue-700 hover:text-blue-900 flex items-center gap-2 mb-4">
        <i class="fa-solid fa-arrow-left text-xs"></i> Volver a mis consultas
    </a>

    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 sm:p-8">
        <h1 class="text-xl font-extrabold text-slate-800 mb-1 flex items-center gap-2">
            <i class="fa-solid fa-comments text-orange-600"></i> Nueva consulta
        </h1>
        <p class="text-xs text-slate-500 mb-6">Contanos tu duda con el mayor detalle posible. Si necesitás un documento, usá <a href="/alumno/solicitudes/nueva" class="text-blue-700 font-semibold hover:underline">Solicitar un trámite</a>.</p>

        <% if (error) { %>
        <div class="bg-red-50 border border-red-200 text-red-700 text-sm rounded-xl p-3 mb-5 flex items-center gap-2">
            <i class="fa-solid fa-circle-exclamation"></i> <%= error %>
        </div>
        <% } %>

        <form action="/alumno/consultas" method="POST" class="space-y-5">
            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1.5" for="categoria">Tema</label>
                <select id="categoria" name="categoria" class="w-full text-sm px-3 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-600">
                    <% categorias.forEach(c => { %>
                    <option value="<%= c %>" <%= valores.categoria === c ? 'selected' : '' %>><%= c %></option>
                    <% }) %>
                </select>
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1.5" for="asunto">Asunto</label>
                <input id="asunto" type="text" name="asunto" required maxlength="150" value="<%= valores.asunto || '' %>"
                       placeholder="Ej: Fecha de examen final de Contabilidad"
                       class="w-full text-sm px-3 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-600">
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1.5" for="mensaje">Tu consulta</label>
                <textarea id="mensaje" name="mensaje" rows="6" required maxlength="3000"
                          placeholder="Escribí acá tu consulta..."
                          class="w-full text-sm p-3 bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-600"><%= valores.mensaje || '' %></textarea>
            </div>
            <div class="flex justify-end gap-3 pt-2">
                <a href="/alumno/consultas" class="px-5 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-sm rounded-xl transition">Cancelar</a>
                <button type="submit" class="px-5 py-2.5 bg-blue-700 hover:bg-blue-800 text-white font-bold text-sm rounded-xl transition shadow inline-flex items-center gap-2">
                    <i class="fa-solid fa-paper-plane"></i> Enviar consulta
                </button>
            </div>
        </form>
    </div>
</div>

<%- include('../partials/footer') %>
