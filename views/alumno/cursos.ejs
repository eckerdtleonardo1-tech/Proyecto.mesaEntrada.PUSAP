<%- include('../partials/header') %>

<div class="max-w-5xl mx-auto px-4 sm:px-6 py-6">
    <div class="flex items-center justify-between mb-6">
        <h1 class="text-xl font-extrabold text-slate-800 flex items-center gap-2">
            <i class="fa-solid fa-chalkboard-user text-blue-600"></i> Mis Cursos
        </h1>
    </div>

    <% if (cursos.length === 0) { %>
    <div class="bg-white rounded-2xl border border-slate-200 p-12 text-center">
        <div class="w-16 h-16 bg-blue-100 rounded-2xl flex items-center justify-center mx-auto mb-4">
            <i class="fa-solid fa-chalkboard text-blue-500 text-2xl"></i>
        </div>
        <p class="text-slate-500">No tenés cursos registrados aún.</p>
    </div>
    <% } else { %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <% cursos.forEach(curso => { %>
        <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-5 hover:border-blue-300 transition">
            <div class="flex items-start justify-between gap-3 mb-3">
                <h3 class="font-bold text-slate-800"><%= curso.nombre %></h3>
                <span class="text-xs px-2.5 py-1 rounded-full font-semibold shrink-0
                    <%= curso.estado_cursada === 'cursando' ? 'bg-green-100 text-green-700' :
                        curso.estado_cursada === 'aprobada' ? 'bg-blue-100 text-blue-700' :
                        'bg-slate-100 text-slate-600' %>">
                    <%= curso.estado_cursada %>
                </span>
            </div>
            <div class="space-y-1.5 text-sm text-slate-500">
                <% if (curso.carrera_nombre) { %>
                <p><i class="fa-solid fa-graduation-cap w-4 text-blue-500 mr-1"></i><%= curso.carrera_nombre %></p>
                <% } %>
                <% if (curso.comision) { %>
                <p><i class="fa-solid fa-users w-4 text-blue-500 mr-1"></i>Comisión: <span class="font-medium text-slate-700"><%= curso.comision %></span></p>
                <% } %>
                <% if (curso.docente) { %>
                <p><i class="fa-solid fa-user-tie w-4 text-blue-500 mr-1"></i><%= curso.docente %></p>
                <% } %>
                <% if (curso.dias_horarios) { %>
                <p><i class="fa-regular fa-clock w-4 text-blue-500 mr-1"></i><%= curso.dias_horarios %></p>
                <% } %>
                <% if (curso.aula) { %>
                <p><i class="fa-solid fa-door-open w-4 text-blue-500 mr-1"></i>Aula: <span class="font-medium text-slate-700"><%= curso.aula %></span></p>
                <% } %>
                <% if (curso.modalidad) { %>
                <p><i class="fa-solid fa-signal w-4 text-blue-500 mr-1"></i><%= curso.modalidad.charAt(0).toUpperCase() + curso.modalidad.slice(1) %></p>
                <% } %>
            </div>
        </div>
        <% }) %>
    </div>
    <% } %>
</div>

<%- include('../partials/footer') %>
