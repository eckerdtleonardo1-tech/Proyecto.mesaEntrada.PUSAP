<%- include('../partials/header') %>

<div class="max-w-5xl mx-auto px-4 sm:px-6 py-6 space-y-6">

    <%# Banner "Ir a mi panel" para usuario logueado que llega desde el home público %>
    
    <!-- Encabezado de bienvenida -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
        <div class="flex items-center gap-4">
            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-blue-700 to-blue-900 flex items-center justify-center text-white text-2xl font-extrabold shadow-md">
                <%= alumno.nombre.charAt(0).toUpperCase() %>
            </div>
            <div>
                <h1 class="text-xl font-extrabold text-slate-900">Hola, <%= alumno.nombre %> 👋</h1>
                <p class="text-sm text-slate-500 mt-0.5">
                    Legajo: <span class="font-semibold text-slate-700"><%= alumno.legajo %></span>
                    <% if (alumno.carreras_nombres) { %>
                    · <span class="text-blue-700 font-medium"><%= alumno.carreras_nombres %></span>
                    <% } %>
                </p>
            </div>
        </div>
    </div>

    <!-- Alertas -->
    <% const hayAlertas = cuotasVencidas.length > 0 || solicitudesObservadas.length > 0; %>
    <% if (hayAlertas) { %>
    <div class="space-y-3">
        <% if (cuotasVencidas.length > 0) { %>
        <div class="bg-red-50 border border-red-200 rounded-xl p-4 flex items-start gap-3">
            <i class="fa-solid fa-circle-exclamation text-red-500 mt-0.5 text-lg"></i>
            <div>
                <p class="font-semibold text-red-800 text-sm">Tenés <%= cuotasVencidas.length %> cuota<%= cuotasVencidas.length > 1 ? 's' : '' %> vencida<%= cuotasVencidas.length > 1 ? 's' : '' %></p>
                <p class="text-red-600 text-xs mt-0.5">Regularizá tu situación para no afectar tu cursada.</p>
                <a href="/alumno/cuotas?filtro=vencidas" class="inline-flex items-center gap-1.5 mt-2 text-xs font-bold text-red-700 hover:text-red-900 transition">
                    Ver cuotas vencidas <i class="fa-solid fa-arrow-right text-[10px]"></i>
                </a>
            </div>
        </div>
        <% } %>
        <% if (solicitudesObservadas.length > 0) { %>
        <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 flex items-start gap-3">
            <i class="fa-solid fa-triangle-exclamation text-amber-500 mt-0.5 text-lg"></i>
            <div>
                <p class="font-semibold text-amber-800 text-sm">Tenés <%= solicitudesObservadas.length %> solicitud<%= solicitudesObservadas.length > 1 ? 'es' : '' %> observada<%= solicitudesObservadas.length > 1 ? 's' : '' %></p>
                <p class="text-amber-600 text-xs mt-0.5">El personal solicitó correcciones. Ingresá a cada solicitud para ver el detalle.</p>
                <a href="/alumno/solicitudes" class="inline-flex items-center gap-1.5 mt-2 text-xs font-bold text-amber-700 hover:text-amber-900 transition">
                    Ver mis solicitudes <i class="fa-solid fa-arrow-right text-[10px]"></i>
                </a>
            </div>
        </div>
        <% } %>
    </div>
    <% } %>

    <!-- Grid de accesos rápidos -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <a href="/alumno/cursos" class="bg-white rounded-xl border border-slate-200 p-5 flex flex-col items-center gap-2 hover:border-blue-400 hover:shadow-md transition group text-center">
            <div class="w-11 h-11 rounded-xl bg-blue-100 flex items-center justify-center group-hover:bg-blue-200 transition">
                <i class="fa-solid fa-chalkboard-user text-blue-700 text-lg"></i>
            </div>
            <span class="text-sm font-semibold text-slate-700 group-hover:text-blue-800">Mis Cursos</span>
            <span class="text-xs text-slate-400"><%= cursos.length %> activo<%= cursos.length !== 1 ? 's' : '' %></span>
        </a>
        <a href="/alumno/cuotas" class="bg-white rounded-xl border border-slate-200 p-5 flex flex-col items-center gap-2 hover:border-blue-400 hover:shadow-md transition group text-center">
            <div class="w-11 h-11 rounded-xl bg-green-100 flex items-center justify-center group-hover:bg-green-200 transition">
                <i class="fa-solid fa-file-invoice-dollar text-green-700 text-lg"></i>
            </div>
            <span class="text-sm font-semibold text-slate-700 group-hover:text-blue-800">Mis Cuotas</span>
            <% if (cuotasVencidas.length > 0) { %>
            <span class="text-xs text-red-600 font-semibold"><%= cuotasVencidas.length %> vencida<%= cuotasVencidas.length > 1 ? 's' : '' %></span>
            <% } else { %>
            <span class="text-xs text-slate-400">Al día ✓</span>
            <% } %>
        </a>
        <a href="/alumno/solicitudes" class="bg-white rounded-xl border border-slate-200 p-5 flex flex-col items-center gap-2 hover:border-blue-400 hover:shadow-md transition group text-center">
            <div class="w-11 h-11 rounded-xl bg-purple-100 flex items-center justify-center group-hover:bg-purple-200 transition">
                <i class="fa-solid fa-folder-open text-purple-700 text-lg"></i>
            </div>
            <span class="text-sm font-semibold text-slate-700 group-hover:text-blue-800">Solicitudes</span>
            <% if (solicitudesObservadas.length > 0) { %>
            <span class="text-xs text-amber-600 font-semibold"><%= solicitudesObservadas.length %> observada<%= solicitudesObservadas.length > 1 ? 's' : '' %></span>
            <% } else { %>
            <span class="text-xs text-slate-400">Documentación</span>
            <% } %>
        </a>
        <a href="/alumno/tramites" class="bg-white rounded-xl border border-slate-200 p-5 flex flex-col items-center gap-2 hover:border-blue-400 hover:shadow-md transition group text-center">
            <div class="w-11 h-11 rounded-xl bg-orange-100 flex items-center justify-center group-hover:bg-orange-200 transition">
                <i class="fa-solid fa-receipt text-orange-700 text-lg"></i>
            </div>
            <span class="text-sm font-semibold text-slate-700 group-hover:text-blue-800">Mis Trámites</span>
            <span class="text-xs text-slate-400">Mesa de Entrada</span>
        </a>
    </div>

    <!-- Cursos activos (preview) -->
    <% if (cursos.length > 0) { %>
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100">
            <h2 class="font-bold text-slate-800 flex items-center gap-2">
                <i class="fa-solid fa-chalkboard-user text-blue-600"></i> Cursos activos
            </h2>
            <a href="/alumno/cursos" class="text-xs text-blue-700 font-semibold hover:underline">Ver todos</a>
        </div>
        <div class="divide-y divide-slate-50">
            <% cursos.slice(0, 4).forEach(curso => { %>
            <div class="px-6 py-3 flex items-center justify-between gap-4">
                <div>
                    <p class="font-semibold text-sm text-slate-800"><%= curso.nombre %></p>
                    <p class="text-xs text-slate-400 mt-0.5">
                        <% if (curso.docente) { %><i class="fa-solid fa-user-tie mr-1"></i><%= curso.docente %> · <% } %>
                        <% if (curso.dias_horarios) { %><i class="fa-regular fa-clock mr-1"></i><%= curso.dias_horarios %><% } %>
                    </p>
                </div>
                <span class="text-xs bg-blue-100 text-blue-700 px-2 py-1 rounded-lg font-medium whitespace-nowrap"><%= curso.modalidad %></span>
            </div>
            <% }) %>
        </div>
    </div>
    <% } %>

</div>

<%- include('../partials/footer') %>
