<%- include('partials/header') %>

<div class="max-w-5xl mx-auto space-y-6">
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-slate-900 flex items-center gap-2 dark:text-slate-100">
            <i class="fa-solid fa-gears text-blue-700 dark:text-blue-400"></i>
            Configuración del Sistema
        </h1>
        <p class="text-slate-500 text-sm mt-1 dark:text-slate-400">Ajustes generales, email y áreas.</p>
    </div>

    <%
        const avisos = {
            area_creada: 'Área creada.', area_guardada: 'Área actualizada (también en los expedientes y usuarios que la usaban).', area_eliminada: 'Área eliminada.',
            respuesta_creada: 'Respuesta rápida creada.', respuesta_guardada: 'Respuesta rápida guardada.', respuesta_eliminada: 'Respuesta rápida eliminada.',
            etiqueta_creada: 'Etiqueta creada.', etiqueta_guardada: 'Etiqueta guardada.', etiqueta_eliminada: 'Etiqueta eliminada (y quitada de los expedientes que la tenían).'
        };
        const cmpC = 'border border-slate-300 rounded-xl py-2 px-3 text-sm focus:ring-blue-500 outline-none dark:bg-slate-700 dark:text-white dark:border-slate-600 dark:placeholder-slate-400';
        const nombreColor = { red: 'Rojo', yellow: 'Amarillo', blue: 'Azul' };
    %>
    <% if (ok && avisos[ok]) { %>
    <div class="bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs rounded-xl p-3 flex items-center gap-2 dark:bg-emerald-900/30 dark:border-emerald-800 dark:text-emerald-300"><i class="fa-solid fa-circle-check"></i> <%= avisos[ok] %></div>
    <% } %>
    <% if (error) { %>
    <div class="bg-red-50 border border-red-200 text-red-700 text-xs rounded-xl p-3 flex items-center gap-2 dark:bg-red-900/30 dark:border-red-800 dark:text-red-400"><i class="fa-solid fa-circle-exclamation"></i> <%= error %></div>
    <% } %>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        
        <!-- Configuración SMTP -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 dark:bg-slate-800 dark:text-slate-100 dark:border-slate-700">
            <div class="flex items-center gap-3 mb-4">
                <i class="fa-solid fa-envelope text-blue-700 text-xl dark:text-blue-400"></i>
                <h3 class="font-bold text-slate-800 dark:text-slate-100">Servidor SMTP</h3>
            </div>
            <p class="text-xs text-slate-500 mb-4 dark:text-slate-400">Configura las credenciales de correo electrónico para el envío de notificaciones.</p>
            <form action="/panel/config/smtp" method="POST" class="space-y-4">
                <div>
                    <label class="block text-xs font-bold text-slate-500 mb-1 uppercase dark:text-slate-400">Host</label>
                    <input type="text" name="smtp_host" value="<%= config.smtp_host || '' %>" placeholder="ej: smtp.gmail.com" class="w-full border border-slate-300 rounded-xl py-2 px-3 text-sm focus:ring-blue-500 outline-none dark:border-slate-600 dark:bg-slate-700 dark:text-white dark:placeholder-slate-400">
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-500 mb-1 uppercase dark:text-slate-400">Puerto</label>
                    <input type="text" name="smtp_port" value="<%= config.smtp_port || '' %>" placeholder="ej: 465" class="w-full border border-slate-300 rounded-xl py-2 px-3 text-sm focus:ring-blue-500 outline-none dark:border-slate-600 dark:bg-slate-700 dark:text-white dark:placeholder-slate-400">
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-500 mb-1 uppercase dark:text-slate-400">Usuario (Email)</label>
                    <input type="text" name="smtp_user" value="<%= config.smtp_user || '' %>" placeholder="ej: noreply@institucion.edu.ar" class="w-full border border-slate-300 rounded-xl py-2 px-3 text-sm focus:ring-blue-500 outline-none dark:border-slate-600 dark:bg-slate-700 dark:text-white dark:placeholder-slate-400">
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-500 mb-1 uppercase dark:text-slate-400">Contraseña</label>
                    <input type="password" name="smtp_pass" value="<%= config.smtp_pass || '' %>" class="w-full border border-slate-300 rounded-xl py-2 px-3 text-sm focus:ring-blue-500 outline-none dark:border-slate-600 dark:bg-slate-700 dark:text-white dark:placeholder-slate-400">
                </div>
                <div class="pt-2 text-right">
                    <button type="submit" class="bg-blue-700 hover:bg-blue-800 text-white font-bold py-2.5 px-5 rounded-xl shadow-sm text-sm transition">
                        Guardar SMTP
                    </button>
                </div>
            </form>
        </div>

        <!-- Gestión de Áreas -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 flex flex-col dark:bg-slate-800 dark:text-slate-100 dark:border-slate-700">
            <div class="flex items-center gap-3 mb-4">
                <i class="fa-solid fa-sitemap text-blue-700 text-xl dark:text-blue-400"></i>
                <h3 class="font-bold text-slate-800 dark:text-slate-100">Áreas de Derivación</h3>
            </div>
            
            <ul class="space-y-2 mb-6 flex-grow">
                <% areas.forEach(a => { %>
                <li class="p-3 bg-slate-50 border border-slate-200 rounded-xl dark:bg-slate-900 dark:text-slate-100 dark:border-slate-700">
                    <% if (a.name === 'Mesa de Entrada') { %>
                    <div class="flex items-center justify-between">
                        <span class="font-medium text-sm text-slate-700 dark:text-slate-200"><%= a.name %></span>
                        <span class="text-[10px] text-slate-500 dark:text-slate-400">área base del sistema · <%= a.usos %> en uso</span>
                    </div>
                    <% } else { %>
                    <form action="/panel/config/areas/editar/<%= a.id %>" method="POST" class="flex items-center gap-2">
                        <input type="text" name="name" value="<%= a.name %>" required class="flex-grow min-w-0 <%= cmpC %> !py-1.5">
                        <span class="text-[10px] text-slate-500 dark:text-slate-400 whitespace-nowrap" title="Expedientes y usuarios en esta área"><%= a.usos %> en uso</span>
                        <button type="submit" class="text-blue-600 hover:text-blue-800 dark:text-blue-400 text-xs font-bold px-2 dark:hover:text-blue-300" title="Guardar nombre"><i class="fa-solid fa-floppy-disk"></i></button>
                        <% if (a.usos > 0) { %>
                        <span class="text-slate-400 text-xs px-2 cursor-not-allowed" title="Tiene <%= a.usos %> expediente(s) o usuario(s): derivalos a otra área antes de borrarla"><i class="fa-solid fa-trash"></i></span>
                        <% } else { %>
                        <button type="submit" formaction="/panel/config/areas/eliminar/<%= a.id %>" formnovalidate onclick="return confirm('¿Eliminar área <%= a.name %>?')" class="text-red-500 hover:text-red-700 text-xs px-2 dark:text-red-400 dark:hover:text-red-300" title="Eliminar"><i class="fa-solid fa-trash"></i></button>
                        <% } %>
                    </form>
                    <% } %>
                </li>
                <% }) %>
            </ul>

            <div class="border-t border-slate-100 pt-4 mt-auto dark:border-slate-700">
                <form action="/panel/config/areas" method="POST" class="flex gap-2">
                    <input type="text" name="new_area" required placeholder="Nombre de nueva área..." class="flex-grow border border-slate-300 rounded-xl py-2 px-3 text-sm focus:ring-blue-500 outline-none dark:bg-slate-700 dark:text-white dark:border-slate-600 dark:placeholder-slate-400">
                    <button type="submit" class="bg-slate-800 hover:bg-slate-900 text-white font-bold py-2 px-4 rounded-xl shadow-sm text-sm transition whitespace-nowrap">
                        Agregar
                    </button>
                </form>
            </div>
        </div>

        <!-- Gestión de Respuestas Rápidas -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 flex flex-col md:col-span-2 dark:bg-slate-800 dark:text-slate-100 dark:border-slate-700">
            <div class="flex items-center gap-3 mb-4">
                <i class="fa-solid fa-reply text-blue-700 text-xl dark:text-blue-400"></i>
                <h3 class="font-bold text-slate-800 dark:text-slate-100">Respuestas Rápidas (Quick Replies)</h3>
            </div>
            
            <ul class="space-y-2 mb-6 flex-grow">
                <% quick_replies.forEach(qr => { %>
                <li class="p-3 bg-slate-50 border border-slate-200 rounded-xl dark:bg-slate-900 dark:text-slate-100 dark:border-slate-700">
                    <form action="/panel/config/quick-replies/editar/<%= qr.id %>" method="POST" class="flex flex-col sm:flex-row gap-2 sm:items-center">
                        <input type="text" name="title" value="<%= qr.title %>" required class="w-full sm:w-1/4 <%= cmpC %> !py-1.5" aria-label="Título">
                        <input type="text" name="content" value="<%= qr.content %>" required class="flex-grow <%= cmpC %> !py-1.5" aria-label="Contenido">
                        <div class="flex items-center gap-1 justify-end">
                            <button type="submit" class="text-blue-600 hover:text-blue-800 dark:text-blue-400 text-xs font-bold px-2 dark:hover:text-blue-300" title="Guardar"><i class="fa-solid fa-floppy-disk"></i></button>
                            <button type="submit" formaction="/panel/config/quick-replies/eliminar/<%= qr.id %>" formnovalidate onclick="return confirm('¿Eliminar respuesta rápida <%= qr.title %>?')" class="text-red-500 hover:text-red-700 text-xs px-2 dark:text-red-400 dark:hover:text-red-300" title="Eliminar"><i class="fa-solid fa-trash"></i></button>
                        </div>
                    </form>
                </li>
                <% }) %>
            </ul>

            <div class="border-t border-slate-100 pt-4 mt-auto dark:border-slate-700">
                <form action="/panel/config/quick-replies/nuevo" method="POST" class="flex flex-col sm:flex-row gap-2">
                    <input type="text" name="title" required placeholder="Título corto (ej: Aprobado)..." class="w-full sm:w-1/4 border border-slate-300 rounded-xl py-2 px-3 text-sm focus:ring-blue-500 outline-none dark:bg-slate-700 dark:text-white dark:border-slate-600 dark:placeholder-slate-400">
                    <input type="text" name="content" required placeholder="Contenido de la respuesta (se enviará al usuario)..." class="flex-grow border border-slate-300 rounded-xl py-2 px-3 text-sm focus:ring-blue-500 outline-none dark:bg-slate-700 dark:text-white dark:border-slate-600 dark:placeholder-slate-400">
                    <button type="submit" class="w-full sm:w-auto bg-slate-800 hover:bg-slate-900 text-white font-bold py-2 px-4 rounded-xl shadow-sm text-sm transition whitespace-nowrap">
                        Agregar
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Etiquetas de expedientes -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 dark:bg-slate-800 dark:text-slate-100 dark:border-slate-700">
        <div class="flex items-center gap-3 mb-4">
            <i class="fa-solid fa-tags text-blue-700 text-xl dark:text-blue-400"></i>
            <h3 class="font-bold text-slate-800 dark:text-slate-100">Etiquetas de Expedientes</h3>
        </div>
        <p class="text-xs text-slate-500 mb-4 dark:text-slate-400">Se asignan a cada expediente desde su detalle (“Urgente”, “Falta firma”...). Si borrás una, se quita de los expedientes que la tenían.</p>
        <ul class="space-y-2 mb-6">
            <% if (tags.length === 0) { %><li class="text-xs text-slate-500 dark:text-slate-400">Todavía no hay etiquetas.</li><% } %>
            <% tags.forEach(g => { %>
            <li class="p-3 bg-slate-50 border border-slate-200 rounded-xl dark:bg-slate-900 dark:text-slate-100 dark:border-slate-700">
                <form action="/panel/config/tags/editar/<%= g.id %>" method="POST" class="flex items-center gap-2">
                    <input type="text" name="name" value="<%= g.name %>" required maxlength="40" class="flex-grow min-w-0 <%= cmpC %> !py-1.5" aria-label="Nombre">
                    <select name="color" class="<%= cmpC %> !py-1.5" aria-label="Color">
                        <% Object.keys(nombreColor).forEach(c => { %><option value="<%= c %>" <%= g.color === c ? 'selected' : '' %>><%= nombreColor[c] %></option><% }) %>
                    </select>
                    <span class="text-[10px] text-slate-500 dark:text-slate-400 whitespace-nowrap"><%= g.usos %> expediente(s)</span>
                    <button type="submit" class="text-blue-600 hover:text-blue-800 dark:text-blue-400 text-xs font-bold px-2 dark:hover:text-blue-300" title="Guardar"><i class="fa-solid fa-floppy-disk"></i></button>
                    <button type="submit" formaction="/panel/config/tags/eliminar/<%= g.id %>" formnovalidate onclick="return confirm('¿Eliminar la etiqueta <%= g.name %>? Se quita de <%= g.usos %> expediente(s).')" class="text-red-500 hover:text-red-700 text-xs px-2 dark:text-red-400 dark:hover:text-red-300" title="Eliminar"><i class="fa-solid fa-trash"></i></button>
                </form>
            </li>
            <% }) %>
        </ul>
        <div class="border-t border-slate-100 pt-4 dark:border-slate-700">
            <form action="/panel/config/tags/nuevo" method="POST" class="flex flex-col sm:flex-row gap-2">
                <input type="text" name="name" required maxlength="40" placeholder="Nombre de la nueva etiqueta..." class="flex-grow <%= cmpC %>">
                <select name="color" class="<%= cmpC %>" aria-label="Color">
                    <% Object.keys(nombreColor).forEach(c => { %><option value="<%= c %>"><%= nombreColor[c] %></option><% }) %>
                </select>
                <button type="submit" class="bg-slate-800 hover:bg-slate-900 text-white font-bold py-2 px-4 rounded-xl shadow-sm text-sm transition whitespace-nowrap">Agregar</button>
            </form>
        </div>
    </div>

    <!-- Mensaje de Bienvenida -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 dark:bg-slate-800 dark:text-slate-100 dark:border-slate-700">
        <div class="flex items-center gap-3 mb-4">
            <i class="fa-solid fa-bullhorn text-blue-700 text-xl dark:text-blue-400"></i>
            <h3 class="font-bold text-slate-800 dark:text-slate-100">Mensaje de Bienvenida del Portal</h3>
        </div>
        <p class="text-xs text-slate-500 mb-4 dark:text-slate-400">Este mensaje se mostrará de forma destacada en la página principal del portal público.</p>
        <form action="/panel/config/general" method="POST" class="space-y-4">
            <div>
                <textarea name="welcome_message" rows="3" placeholder="Ej: ¡Atención! Del 10 al 15 de marzo estarán habilitadas las inscripciones a equivalencias..." class="w-full border border-slate-300 rounded-xl py-2 px-3 text-sm focus:ring-blue-500 outline-none resize-none dark:bg-slate-700 dark:text-white dark:border-slate-600 dark:placeholder-slate-400"><%= config.welcome_message || '' %></textarea>
            </div>
            <div class="pt-2 text-right">
                <button type="submit" class="bg-blue-700 hover:bg-blue-800 text-white font-bold py-2.5 px-5 rounded-xl shadow-sm text-sm transition">
                    Guardar Mensaje
                </button>
            </div>
        </form>
    </div>

    <!-- Anuncio Público -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 dark:bg-slate-800 dark:text-slate-100 dark:border-slate-700">
        <div class="flex items-center gap-3 mb-4">
            <i class="fa-solid fa-triangle-exclamation text-blue-700 text-xl dark:text-blue-400"></i>
            <h3 class="font-bold text-slate-800 dark:text-slate-100">Tablero de Anuncio Público</h3>
        </div>
        <p class="text-xs text-slate-500 mb-4 dark:text-slate-400">Este anuncio se mostrará como un banner de alerta llamativo en la parte superior del portal público.</p>
        <form action="/panel/config/anuncio" method="POST" class="space-y-4">
            <div>
                <label class="block text-xs font-bold text-slate-500 mb-1 uppercase dark:text-slate-400">Texto del Anuncio</label>
                <textarea name="public_announcement" rows="3" placeholder="Ej: El sistema estará en mantenimiento el fin de semana..." class="w-full border border-slate-300 rounded-xl py-2 px-3 text-sm focus:ring-blue-500 outline-none resize-none dark:bg-slate-700 dark:text-white dark:border-slate-600 dark:placeholder-slate-400"><%= config.public_announcement || '' %></textarea>
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-500 mb-1 uppercase dark:text-slate-400">Tipo de Alerta</label>
                <select name="announcement_type" class="w-full border border-slate-300 rounded-xl py-2 px-3 text-sm focus:ring-blue-500 outline-none dark:bg-slate-700 dark:text-white dark:border-slate-600 dark:placeholder-slate-400">
                    <option value="amber" <%= config.announcement_type === 'amber' ? 'selected' : '' %>>Advertencia (Naranja)</option>
                    <option value="red" <%= config.announcement_type === 'red' ? 'selected' : '' %>>Peligro (Rojo)</option>
                    <option value="blue" <%= config.announcement_type === 'blue' ? 'selected' : '' %>>Informativo (Azul)</option>
                    <option value="green" <%= config.announcement_type === 'green' ? 'selected' : '' %>>Éxito (Verde)</option>
                </select>
            </div>
            <div class="pt-2 text-right">
                <button type="submit" class="bg-blue-700 hover:bg-blue-800 text-white font-bold py-2.5 px-5 rounded-xl shadow-sm text-sm transition">
                    Guardar Anuncio
                </button>
            </div>
        </form>
    </div>
</div>

<%- include('partials/footer') %>
