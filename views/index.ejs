<%- include('partials/header') %>

<% if (typeof announcement !== 'undefined' && announcement && announcement.trim() !== '') { %>
    <%
        let bgColor = 'bg-amber-100';
        let borderColor = 'border-amber-500';
        let textColor = 'text-amber-800';
        let iconColor = 'text-amber-600';

        if (announcement_type === 'red') {
            bgColor = 'bg-red-100'; borderColor = 'border-red-500'; textColor = 'text-red-800'; iconColor = 'text-red-600';
        } else if (announcement_type === 'blue') {
            bgColor = 'bg-blue-100'; borderColor = 'border-blue-500'; textColor = 'text-blue-800'; iconColor = 'text-blue-600';
        } else if (announcement_type === 'green') {
            bgColor = 'bg-green-100'; borderColor = 'border-green-500'; textColor = 'text-green-800'; iconColor = 'text-green-600';
        }
    %>
    <div class="<%= bgColor %> border-l-4 <%= borderColor %> <%= textColor %> p-4 shadow-md relative z-50">
        <div class="max-w-6xl mx-auto flex items-center gap-3">
            <i class="fa-solid fa-circle-exclamation <%= iconColor %> text-xl flex-shrink-0"></i>
            <p class="font-bold text-sm md:text-base"><%= announcement %></p>
        </div>
    </div>
<% } %>

<!-- Hero: el texto lo edita el personal desde "Datos Institucionales" -->
<div class="relative bg-gradient-to-br from-blue-950 via-blue-900 to-slate-900 text-white overflow-hidden">
    <div class="absolute top-0 right-0 -mr-20 -mt-20 w-96 h-96 rounded-full bg-blue-600/20 blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 -ml-20 -mb-20 w-80 h-80 rounded-full bg-blue-800/20 blur-3xl pointer-events-none"></div>

    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 py-16 lg:py-24">
        <div class="flex flex-col lg:flex-row items-center gap-12">
            <div class="flex-1 text-center lg:text-left slide-up">
                <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm border border-white/20 text-blue-100 text-xs font-bold uppercase tracking-wider px-4 py-2 rounded-full mb-6">
                    <i class="fa-solid fa-building-columns"></i>
                    Centro Universitario PUSAP
                </div>
                <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-white leading-tight mb-6">
                    <%= contenido.hero_titulo %>
                </h1>
                <p class="text-slate-300 text-lg md:text-xl leading-relaxed mb-8 max-w-xl mx-auto lg:mx-0 font-light">
                    <%= contenido.hero_subtitulo %>
                </p>
                <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
                    <a href="/carreras" class="group bg-blue-600 hover:bg-blue-500 text-white font-bold py-4 px-8 rounded-xl shadow-lg shadow-blue-900/50 hover:shadow-blue-500/30 hover:-translate-y-0.5 transition-all duration-300 flex items-center justify-center gap-3 border border-blue-500">
                        <i class="fa-solid fa-graduation-cap text-xl"></i>
                        <span class="text-base sm:text-lg">Ver oferta académica</span>
                        <i class="fa-solid fa-arrow-right text-sm group-hover:translate-x-1.5 transition-transform"></i>
                    </a>
                    <a href="/ingresar" class="bg-slate-800/80 hover:bg-slate-700 border border-slate-600 text-white font-bold py-4 px-8 rounded-xl transition-all duration-300 flex items-center justify-center gap-3 hover:-translate-y-0.5">
                        <i class="fa-solid fa-lock text-xl text-blue-400"></i>
                        <span class="text-base sm:text-lg">Soy alumno</span>
                    </a>
                </div>
                <div class="mt-6 flex items-center justify-center lg:justify-start gap-4 text-xs text-blue-200/80">
                    <a href="/#ventajas" class="hover:text-white transition flex items-center gap-1.5 underline decoration-blue-400/50">
                        <i class="fa-solid fa-award"></i> Por qué elegirnos
                    </a>
                    <span>·</span>
                    <a href="/contacto" class="hover:text-white transition flex items-center gap-1.5 underline decoration-blue-400/50">
                        <i class="fa-solid fa-headset"></i> Cómo inscribirte
                    </a>
                </div>
            </div>

            <!-- Qué ofrece el portal del alumno -->
            <div class="hidden lg:block flex-1 relative scale-in">
                <div class="relative w-full max-w-md mx-auto">
                    <div class="bg-white/10 backdrop-blur-md border border-white/20 rounded-3xl p-7 shadow-2xl relative z-10">
                        <div class="flex items-center gap-3 mb-5 pb-5 border-b border-white/15">
                            <div class="w-11 h-11 bg-blue-600 rounded-xl flex items-center justify-center shadow-lg"><i class="fa-solid fa-laptop text-white text-lg"></i></div>
                            <div>
                                <p class="font-bold text-sm text-white">Portal del Alumno</p>
                                <p class="text-xs text-blue-200">Para quienes ya están inscriptos</p>
                            </div>
                        </div>
                        <div class="space-y-3.5">
                            <div class="flex items-center gap-3 bg-white/5 p-3 rounded-xl border border-white/10">
                                <div class="w-8 h-8 rounded-full bg-blue-500/30 flex items-center justify-center text-blue-200 text-xs"><i class="fa-solid fa-comments"></i></div>
                                <div class="flex-1">
                                    <p class="text-xs font-semibold text-white">Hacé consultas al personal</p>
                                    <p class="text-[10px] text-slate-300">Recibí la respuesta en tu portal</p>
                                </div>
                            </div>
                            <div class="flex items-center gap-3 bg-white/5 p-3 rounded-xl border border-white/10">
                                <div class="w-8 h-8 rounded-full bg-blue-500/30 flex items-center justify-center text-blue-200 text-xs"><i class="fa-solid fa-file-signature"></i></div>
                                <div class="flex-1">
                                    <p class="text-xs font-semibold text-white">Solicitá trámites online</p>
                                    <p class="text-[10px] text-slate-300">Certificados, constancias y más</p>
                                </div>
                            </div>
                            <div class="flex items-center gap-3 bg-blue-500/20 p-3 rounded-xl border border-blue-400/30">
                                <div class="w-8 h-8 rounded-full bg-blue-500 flex items-center justify-center text-white text-xs"><i class="fa-solid fa-building-columns"></i></div>
                                <div class="flex-1">
                                    <p class="text-xs font-bold text-blue-200">Finalizalo en la institución</p>
                                    <p class="text-[10px] text-blue-300">Te avisamos cuándo acercarte</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<% if (typeof welcome_message !== 'undefined' && welcome_message && welcome_message.trim() !== '') { %>
<div class="bg-blue-50 border-b border-blue-100 py-4">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="flex items-center gap-3 text-blue-900">
            <div class="w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center shrink-0">
                <i class="fa-solid fa-bullhorn text-blue-600"></i>
            </div>
            <p class="font-medium text-sm sm:text-base"><%= welcome_message %></p>
        </div>
    </div>
</div>
<% } %>

<!-- Ventajas (las administra el personal) -->
<% if (typeof ventajas !== 'undefined' && ventajas && ventajas.length > 0) { %>
<div id="ventajas" class="bg-slate-50 py-16 border-b border-slate-200 scroll-mt-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="text-center mb-12">
            <div class="inline-flex items-center gap-2 bg-blue-100 text-blue-800 text-xs font-bold px-3 py-1 rounded-full mb-3">
                <i class="fa-solid fa-award"></i> Por qué elegirnos
            </div>
            <h2 class="text-3xl font-extrabold text-slate-900 mb-3">Ventajas de estudiar en PUSAP</h2>
            <p class="text-slate-600 max-w-2xl mx-auto text-base">Lo que nos distingue como institución.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            <% ventajas.forEach(v => { %>
            <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200 hover:shadow-xl hover:border-blue-300 transition-all duration-300 group">
                <div class="w-14 h-14 bg-blue-50 group-hover:bg-blue-600 rounded-xl flex items-center justify-center mb-5 transition-colors">
                    <i class="fa-solid <%= v.icono || 'fa-star' %> text-2xl text-blue-600 group-hover:text-white transition-colors"></i>
                </div>
                <h3 class="text-lg font-bold text-slate-900 mb-2"><%= v.titulo %></h3>
                <% if (v.descripcion) { %>
                <p class="text-sm text-slate-500 leading-relaxed"><%= v.descripcion %></p>
                <% } %>
            </div>
            <% }) %>
        </div>
    </div>
</div>
<% } %>

<!-- Oferta Académica Destacada -->
<% if (typeof carreras !== 'undefined' && carreras && carreras.length > 0) { %>
<div class="py-16 bg-white border-b border-slate-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10">
            <div>
                <div class="inline-flex items-center gap-2 bg-blue-100 text-blue-800 text-xs font-bold px-3 py-1 rounded-full mb-2">
                    <i class="fa-solid fa-graduation-cap"></i> Formación Académica
                </div>
                <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900">Carreras y Cursos Destacados</h2>
            </div>
            <a href="/carreras" class="text-xs font-bold text-blue-700 hover:text-blue-900 flex items-center gap-1.5 transition">
                Ver toda la oferta académica <i class="fa-solid fa-arrow-right text-[10px]"></i>
            </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <% carreras.forEach(c => { %>
            <div class="bg-slate-50 rounded-2xl border border-slate-200 p-6 flex flex-col justify-between hover:border-blue-300 hover:shadow-md transition">
                <div>
                    <div class="flex items-center gap-2 mb-3">
                        <span class="text-[10px] font-bold px-2.5 py-0.5 rounded-full <%= c.tipo === 'carrera' ? 'bg-blue-100 text-blue-800' : 'bg-purple-100 text-purple-800' %> uppercase">
                            <%= c.tipo %>
                        </span>
                        <span class="text-[10px] font-bold px-2.5 py-0.5 rounded-full bg-slate-200 text-slate-700 capitalize">
                            <%= c.modalidad %>
                        </span>
                        <% if (c.duracion) { %>
                        <span class="text-[10px] text-slate-500"><i class="fa-regular fa-clock mr-1"></i><%= c.duracion %></span>
                        <% } %>
                    </div>
                    <h3 class="text-lg font-bold text-slate-900 mb-2"><%= c.nombre %></h3>
                    <p class="text-xs text-slate-500 mb-4 line-clamp-2"><%= c.descripcion %></p>
                </div>
                <div class="pt-4 border-t border-slate-200 flex items-center justify-between">
                    <span class="text-xs text-slate-600"><%= c.aranceles ? c.aranceles.split('.')[0] : 'Consultar aranceles' %></span>
                    <a href="/carreras" class="text-xs font-bold text-blue-700 hover:text-blue-900 flex items-center gap-1">
                        Ver detalle <i class="fa-solid fa-chevron-right text-[9px]"></i>
                    </a>
                </div>
            </div>
            <% }) %>
        </div>
    </div>
</div>
<% } %>

<!-- Novedades (sólo las dirigidas al público) -->
<% if (typeof novedades !== 'undefined' && novedades && novedades.length > 0) { %>
<div class="py-16 bg-slate-100/70 border-b border-slate-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="mb-8">
            <div class="inline-flex items-center gap-2 bg-blue-100 text-blue-800 text-xs font-bold px-3 py-1 rounded-full mb-2">
                <i class="fa-solid fa-bullhorn"></i> Comunicados Oficiales
            </div>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900">Novedades y Anuncios</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <% novedades.forEach(nov => { %>
            <div class="bg-white rounded-2xl p-6 border <%= nov.destacada ? 'border-amber-400 ring-2 ring-amber-400/20' : 'border-slate-200' %> shadow-sm hover:shadow-md transition flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between gap-2 mb-3">
                        <span class="text-xs text-slate-400 flex items-center gap-1.5">
                            <i class="fa-regular fa-calendar"></i>
                            <%= moment(nov.fecha_publicacion).format('DD [de] MMMM, YYYY') %>
                        </span>
                        <% if (nov.destacada) { %>
                        <span class="inline-flex items-center gap-1 text-[10px] font-bold bg-amber-100 text-amber-800 px-2.5 py-0.5 rounded-full border border-amber-200">
                            <i class="fa-solid fa-star text-[9px] text-amber-500"></i> Destacada
                        </span>
                        <% } %>
                    </div>
                    <h3 class="text-lg font-bold text-slate-900 mb-2 leading-snug"><%= nov.titulo %></h3>
                    <p class="text-slate-600 text-sm leading-relaxed mb-4"><%= nov.cuerpo %></p>
                </div>
                <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-400">
                    <span class="flex items-center gap-1"><i class="fa-solid fa-building-columns text-blue-600"></i> PUSAP</span>
                    <span class="text-blue-600 font-bold">Oficial</span>
                </div>
            </div>
            <% }) %>
        </div>
    </div>
</div>
<% } %>

<!-- Cómo es el circuito del alumno -->
<div class="max-w-6xl mx-auto px-4 sm:px-6 py-16">
    <div class="text-center mb-12">
        <div class="inline-flex items-center gap-2 bg-blue-100 text-blue-800 text-xs font-bold px-3 py-1 rounded-full mb-3">
            <i class="fa-solid fa-route"></i> Paso a paso
        </div>
        <h2 class="text-3xl font-extrabold text-slate-900 mb-3">Así funciona para el alumno</h2>
        <p class="text-slate-600 max-w-2xl mx-auto">La gestión empieza online y se cierra en persona, con todo registrado.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm">
            <div class="w-10 h-10 rounded-full bg-blue-100 text-blue-700 flex items-center justify-center font-bold mb-4">1</div>
            <h3 class="font-bold text-slate-900 mb-1 flex items-center gap-2"><i class="fa-solid fa-user-plus text-blue-500"></i> Inscribite</h3>
            <p class="text-slate-500 text-sm">Acercate a la institución con tu documentación. Te damos de alta y te habilitamos el acceso.</p>
        </div>
        <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm">
            <div class="w-10 h-10 rounded-full bg-blue-100 text-blue-700 flex items-center justify-center font-bold mb-4">2</div>
            <h3 class="font-bold text-slate-900 mb-1 flex items-center gap-2"><i class="fa-solid fa-key text-blue-500"></i> Activá tu cuenta</h3>
            <p class="text-slate-500 text-sm">Con el enlace que te entregamos elegís tu contraseña e ingresás al portal del alumno.</p>
        </div>
        <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm">
            <div class="w-10 h-10 rounded-full bg-blue-100 text-blue-700 flex items-center justify-center font-bold mb-4">3</div>
            <h3 class="font-bold text-slate-900 mb-1 flex items-center gap-2"><i class="fa-solid fa-comments text-blue-500"></i> Consultá y solicitá</h3>
            <p class="text-slate-500 text-sm">Hacé consultas y pedí trámites desde tu casa. Seguís cada paso desde el portal.</p>
        </div>
        <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm">
            <div class="w-10 h-10 rounded-full bg-blue-100 text-blue-700 flex items-center justify-center font-bold mb-4">4</div>
            <h3 class="font-bold text-slate-900 mb-1 flex items-center gap-2"><i class="fa-solid fa-building-columns text-blue-500"></i> Finalizá en persona</h3>
            <p class="text-slate-500 text-sm">Cuando tu trámite está aprobado te avisamos y lo cerrás en la institución.</p>
        </div>
    </div>

    <div class="text-center mt-10">
        <a href="/ingresar" class="inline-flex items-center gap-2 bg-blue-700 hover:bg-blue-800 text-white font-bold px-8 py-3.5 rounded-xl transition shadow">
            <i class="fa-solid fa-lock"></i> Ingresar al portal
        </a>
    </div>
</div>

<!-- Preguntas frecuentes (sólo las dirigidas al público) -->
<div id="faqs" class="bg-white py-16 border-t border-slate-100 scroll-mt-24">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <div class="text-center mb-10">
            <div class="inline-flex items-center gap-2 bg-blue-100 text-blue-800 text-xs font-bold px-3 py-1 rounded-full mb-3">
                <i class="fa-solid fa-circle-question"></i> Respuestas Frecuentes
            </div>
            <h2 class="text-3xl font-extrabold text-slate-900 mb-3">Preguntas Frecuentes</h2>
            <p class="text-slate-500 text-base">Lo que más nos preguntan antes de inscribirse.</p>
        </div>

        <% if (typeof faqs !== 'undefined' && faqs && faqs.length > 0) { %>
        <div class="space-y-4">
            <% faqs.forEach((faq, idx) => { %>
            <div class="border border-slate-200 rounded-2xl bg-slate-50 overflow-hidden hover:border-blue-300 transition-colors">
                <button
                    class="w-full px-6 py-5 text-left font-bold text-slate-800 flex justify-between items-center focus:outline-none gap-4"
                    onclick="toggleFaq('faq-<%= idx %>', 'icon-<%= idx %>')"
                    aria-expanded="false"
                >
                    <span class="flex items-center gap-3">
                        <span class="text-xs font-bold uppercase tracking-wider bg-blue-100 text-blue-800 px-2.5 py-0.5 rounded-lg shrink-0">
                            <%= faq.categoria %>
                        </span>
                        <span class="text-sm sm:text-base"><%= faq.pregunta %></span>
                    </span>
                    <i id="icon-<%= idx %>" class="fa-solid fa-chevron-down text-slate-400 transition-transform duration-200 shrink-0"></i>
                </button>
                <div id="faq-<%= idx %>" class="hidden px-6 pb-5 pt-1 text-slate-600 text-sm leading-relaxed border-t border-slate-200/50">
                    <%= faq.respuesta %>
                </div>
            </div>
            <% }) %>
        </div>
        <% } else { %>
        <div class="border border-slate-200 rounded-2xl bg-slate-50 p-6 text-center text-slate-500 text-sm">
            Las preguntas frecuentes se encuentran en actualización. Podés comunicarte con <a href="/contacto" class="text-blue-600 font-bold underline">Mesa de Entrada</a>.
        </div>
        <% } %>

        <div class="text-center mt-8">
            <p class="text-xs text-slate-400">
                ¿No encontrás la respuesta?
                <a href="/contacto" class="text-blue-700 font-bold hover:underline">Contactate con nuestro equipo de atención</a>.
            </p>
        </div>
    </div>
</div>

<script>
    function toggleFaq(id, iconId) {
        const content = document.getElementById(id);
        const icon = document.getElementById(iconId);
        const isHidden = content.classList.contains('hidden');

        if (isHidden) {
            content.classList.remove('hidden');
            icon.classList.add('rotate-180');
        } else {
            content.classList.add('hidden');
            icon.classList.remove('rotate-180');
        }
    }
</script>

<%- include('partials/footer') %>
