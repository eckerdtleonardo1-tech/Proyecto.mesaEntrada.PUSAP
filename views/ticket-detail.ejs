<%- include('partials/header') %>

<style media="print">
    header, aside, .print\:hidden, footer, #updateForm, .lg\:col-span-1 { display: none !important; }
    body, main, .bg-slate-50 { background: white !important; margin: 0; padding: 0; }
    .lg\:col-span-2 { width: 100% !important; margin: 0; }
    .max-w-5xl { max-width: 100% !important; }
    
    body::before {
        content: 'PUSAP - Mesa de Entrada';
        display: block;
        text-align: center;
        font-size: 24px;
        font-weight: bold;
        margin-bottom: 20px;
        border-bottom: 2px solid black;
        padding-bottom: 10px;
    }
    
    .bg-gradient-to-r { background: white !important; color: black !important; border: 2px solid #ccc; padding: 10px; border-radius: 0; }
    .text-white { color: black !important; }
    .text-blue-200, .text-blue-300 { color: #555 !important; }
    .shadow-sm { box-shadow: none !important; }
</style>

<div class="max-w-5xl mx-auto">
    <!-- Back button -->
    <div class="mb-6 print:hidden">
        <a href="/panel" class="inline-flex items-center gap-2 text-sm text-slate-500 hover:text-blue-700 transition-colors">
            <i class="fa-solid fa-arrow-left text-xs"></i>
            Volver al Panel
        </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        <!-- ====== COLUMNA PRINCIPAL (2/3) ====== -->
        <div class="lg:col-span-2 space-y-6">

            <!-- Info del expediente -->
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
                <div class="bg-gradient-to-r from-blue-900 to-blue-800 px-6 py-4 flex items-start justify-between gap-4">
                    <div>
                        <p class="text-blue-200 text-xs font-semibold uppercase tracking-wider mb-1">Expediente</p>
                        <div class="flex items-center gap-2">
                            <h2 class="text-2xl font-extrabold text-white font-mono"><%= ticket.tracking_code %></h2>
                            <button type="button" onclick="navigator.clipboard.writeText('<%= ticket.tracking_code %>').then(()=>alert('Código copiado al portapapeles'))" class="text-blue-300 hover:text-white transition print:hidden" title="Copiar código"><i class="fa-regular fa-copy"></i></button>
                        </div>
                        <p class="text-blue-300 text-xs mt-1"><i class="fa-regular fa-clock mr-1"></i>Ingresado: <%= moment.utc(ticket.created_at).local().format('DD/MM/YYYY [a las] HH:mm') %></p>
                    </div>
                    <div class="flex gap-2 print:hidden">
                        <button type="button" onclick="window.print()" class="flex-shrink-0 inline-flex items-center justify-center gap-1.5 bg-blue-600 hover:bg-blue-700 text-white text-xs font-medium px-4 py-2.5 min-h-[44px] rounded-lg transition">
                            <i class="fa-solid fa-print"></i>
                            Imprimir Vista
                        </button>
                        <a href="/panel/comprobante/<%= ticket.id %>" class="flex-shrink-0 inline-flex items-center justify-center gap-1.5 bg-white/10 hover:bg-white/20 border border-white/25 text-white text-xs font-medium px-4 py-2.5 min-h-[44px] rounded-lg transition">
                            <i class="fa-solid fa-file-pdf"></i>
                            Talón PDF
                        </a>
                    </div>
                </div>

                <!-- Visual Status Panel -->
                <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50">
                    <div class="flex items-center gap-3">
                        <% 
                        let sColor = 'text-slate-500 bg-slate-100';
                        let sIcon = 'fa-circle-dot';
                        if(ticket.status === 'Iniciado') { sColor = 'text-blue-600 bg-blue-100'; sIcon = 'fa-play'; }
                        if(ticket.status === 'En Revisión') { sColor = 'text-purple-600 bg-purple-100'; sIcon = 'fa-magnifying-glass'; }
                        if(ticket.status === 'Pendiente de Documentación') { sColor = 'text-orange-600 bg-orange-100'; sIcon = 'fa-file-circle-exclamation'; }
                        if(ticket.status === 'Aprobado') { sColor = 'text-green-600 bg-green-100'; sIcon = 'fa-check-double'; }
                        if(ticket.status === 'Rechazado') { sColor = 'text-red-600 bg-red-100'; sIcon = 'fa-xmark'; }
                        %>
                        <div class="w-10 h-10 rounded-full flex items-center justify-center <%= sColor %>">
                            <i class="fa-solid <%= sIcon %>"></i>
                        </div>
                        <div>
                            <p class="text-xs font-bold text-slate-400 uppercase">Estado Actual</p>
                            <p class="text-sm font-bold <%= sColor.split(' ')[0] %>"><%= ticket.status %></p>
                        </div>
                    </div>
                    <div class="text-right">
                        <p class="text-xs font-bold text-slate-400 uppercase">Área Responsable</p>
                        <p class="text-sm font-semibold text-slate-700"><i class="fa-solid fa-building text-slate-400 mr-1"></i><%= ticket.area %></p>
                    </div>
                </div>

                <div class="p-6">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                        <div>
                            <p class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Solicitante</p>
                            <p class="text-slate-900 font-semibold text-sm"><%= ticket.first_name %> <%= ticket.last_name %></p>
                        </div>
                        <div>
                            <p class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">DNI / CUIL</p>
                            <p class="text-slate-900 font-semibold text-sm"><%= ticket.dni %> <% if(ticket.cuil) { %>/ <%= ticket.cuil %><% } %></p>
                        </div>
                        <div>
                            <p class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Email</p>
                            <p class="text-slate-900 text-sm truncate"><%= ticket.email %></p>
                        </div>
                        <div>
                            <p class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Teléfono</p>
                            <p class="text-slate-900 text-sm"><%= ticket.phone %></p>
                        </div>
                        <div>
                            <p class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Tipo de Trámite</p>
                            <span class="inline-block bg-blue-50 text-blue-800 border border-blue-200 px-3 py-1 rounded-lg text-sm font-semibold">
                                <%= ticket.category %>
                            </span>
                        </div>
                        <div>
                            <p class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Prioridad</p>
                            <% if(ticket.priority === 'urgente') { %>
                                <span class="inline-block bg-red-50 text-red-700 border border-red-200 px-3 py-1 rounded-lg text-sm font-bold uppercase"><i class="fa-solid fa-bolt mr-1"></i>Urgente</span>
                            <% } else { %>
                                <span class="inline-block bg-slate-50 text-slate-700 border border-slate-200 px-3 py-1 rounded-lg text-sm font-semibold uppercase">Normal</span>
                            <% } %>
                        </div>
                        <% if (ticket.expiration_date) { 
                            const daysLeft = moment(ticket.expiration_date).diff(moment(), 'days');
                            const isExpired = daysLeft < 0;
                            const isNear = daysLeft >= 0 && daysLeft <= 7;
                        %>
                        <div class="sm:col-span-2">
                            <p class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Vencimiento</p>
                            <div class="flex items-center gap-2">
                                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-sm font-semibold border 
                                    <%= isExpired ? 'bg-red-50 text-red-700 border-red-200' : (isNear ? 'bg-orange-50 text-orange-700 border-orange-200' : 'bg-slate-50 text-slate-700 border-slate-200') %>">
                                    <i class="fa-regular fa-calendar-xmark text-xs"></i>
                                    <%= moment(ticket.expiration_date).format('DD/MM/YYYY') %>
                                </span>
                                <% if (isExpired) { %>
                                    <span class="text-xs font-bold text-red-600 bg-red-100 px-2 py-0.5 rounded-full">VENCIDO</span>
                                <% } else if (isNear) { %>
                                    <span class="text-xs font-bold text-orange-600 bg-orange-100 px-2 py-0.5 rounded-full">Vence en <%= daysLeft %> día(s)</span>
                                <% } %>
                            </div>
                        </div>
                        <% } %>
                    </div>
                </div>
            </div>

            <% if (ticket.student_notes) { %>
            <!-- Observaciones del estudiante -->
            <div class="bg-yellow-50 rounded-2xl border border-yellow-200 shadow-sm overflow-hidden p-6 mt-6">
                <h3 class="font-bold text-yellow-900 flex items-center gap-2 mb-2">
                    <i class="fa-solid fa-note-sticky text-yellow-600"></i> Observaciones del Estudiante
                </h3>
                <p class="text-yellow-800 text-sm whitespace-pre-wrap"><%= ticket.student_notes %></p>
            </div>
            <% } %>

            <!-- Formulario de Gestión -->
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm">
                <div class="px-6 py-4 border-b border-slate-200 flex items-center gap-3">
                    <div class="w-8 h-8 bg-blue-50 rounded-lg flex items-center justify-center">
                        <i class="fa-solid fa-arrows-turn-right text-blue-700 text-sm"></i>
                    </div>
                    <h3 class="font-bold text-slate-900">Actualizar Expediente</h3>
                </div>
                <div class="p-6">
                    <form action="/panel/tramite/<%= ticket.id %>" method="POST" id="updateForm" class="space-y-5">
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                            <!-- Estado -->
                            <div>
                                <label class="block text-sm font-semibold text-slate-700 mb-1.5">Estado del Trámite</label>
                                <select name="status" class="block w-full border border-slate-300 rounded-xl py-2.5 px-3.5 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none bg-white text-slate-800">
                                    <option value="Iniciado" <%= ticket.status === 'Iniciado' ? 'selected' : '' %>>🔵 Iniciado</option>
                                    <option value="En Revisión" <%= ticket.status === 'En Revisión' ? 'selected' : '' %>>🟣 En Revisión</option>
                                    <option value="Pendiente de Documentación" <%= ticket.status === 'Pendiente de Documentación' ? 'selected' : '' %>>🟠 Pendiente de Documentación</option>
                                    <option value="Aprobado" <%= ticket.status === 'Aprobado' ? 'selected' : '' %>>🟢 Aprobado</option>
                                    <option value="Rechazado" <%= ticket.status === 'Rechazado' ? 'selected' : '' %>>🔴 Rechazado</option>
                                </select>
                            </div>
                            <!-- Área -->
                            <div>
                                <label class="block text-sm font-semibold text-slate-700 mb-1.5">Derivar a Área</label>
                                <select name="area" class="block w-full border border-slate-300 rounded-xl py-2.5 px-3.5 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none bg-white text-slate-800">
                                    <option value="Mesa de Entrada" <%= ticket.area === 'Mesa de Entrada' ? 'selected' : '' %>>Mesa de Entrada</option>
                                    <option value="Dto. Ingresos" <%= ticket.area === 'Dto. Ingresos' ? 'selected' : '' %>>Dto. Ingresos</option>
                                    <option value="Secretaría Académica" <%= ticket.area === 'Secretaría Académica' ? 'selected' : '' %>>Secretaría Académica</option>
                                    <option value="Dto. Sistema" <%= ticket.area === 'Dto. Sistema' ? 'selected' : '' %>>Dto. Sistema</option>
                                </select>
                            </div>
                            <!-- Vencimiento -->
                            <div class="sm:col-span-2">
                                <label class="block text-sm font-semibold text-slate-700 mb-1.5">
                                    Fecha de Vencimiento
                                    <span class="font-normal text-slate-400 ml-1">(opcional)</span>
                                </label>
                                <div class="flex gap-2 items-center">
                                    <input 
                                        type="date" 
                                        name="expiration_date" 
                                        id="expDateInput"
                                        value="<%= ticket.expiration_date ? moment(ticket.expiration_date).format('YYYY-MM-DD') : '' %>" 
                                        class="block border border-slate-300 rounded-xl py-2.5 px-3.5 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none bg-white"
                                    >
                                    <button type="button" onclick="document.getElementById('expDateInput').value=''" class="text-xs text-red-500 hover:text-red-700 border border-red-200 hover:border-red-300 px-3 py-2.5 rounded-xl transition whitespace-nowrap">
                                        <i class="fa-solid fa-calendar-xmark mr-1"></i>Quitar fecha
                                    </button>
                                </div>
                            </div>
                            
                            <!-- Notas Internas -->
                            <div class="sm:col-span-2">
                                <label class="block text-sm font-semibold text-slate-700 mb-1.5">
                                    Notas internas
                                    <span class="font-normal text-slate-400 ml-1">(Privado para operadores)</span>
                                </label>
                                <textarea 
                                    name="notes" 
                                    rows="2" 
                                    class="block w-full border border-yellow-300 rounded-xl py-2.5 px-3.5 text-sm focus:ring-2 focus:ring-yellow-500 outline-none bg-yellow-50 resize-none" 
                                    placeholder="Agregá notas o recordatorios que solo verá el staff..."
                                ><%= ticket.notes || '' %></textarea>
                            </div>

                        </div>
                        <!-- Comentario al Solicitante -->
                        <div>
                            <label class="block text-sm font-semibold text-slate-700 mb-1.5">
                                Comentario al solicitante
                                <span class="font-normal text-slate-400 ml-1">(se enviará por email)</span>
                            </label>
                            <textarea 
                                id="commentsField"
                                name="comments" 
                                rows="3" 
                                class="block w-full border border-slate-300 rounded-xl py-2.5 px-3.5 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none resize-none" 
                                placeholder="Ej: Falta el certificado de título original. Por favor, adjuntarlo a la brevedad."
                            ></textarea>
                            <div class="mt-2 flex flex-wrap gap-2">
                                <% quick_replies.forEach(qr => { %>
                                <button type="button" onclick="document.getElementById('commentsField').value='<%= qr.content %>'" class="text-xs bg-slate-100 hover:bg-slate-200 text-slate-600 px-2 py-1 rounded border border-slate-200 transition"><%= qr.title %></button>
                                <% }) %>
                                <button type="button" onclick="document.getElementById('commentsField').value=''" class="text-xs text-red-500 hover:text-red-700 px-2 py-1">Limpiar</button>
                            </div>
                        </div>
                        <!-- Action buttons -->
                        <div class="flex gap-3 pt-2">
                            <button type="submit" id="submitBtn" class="flex-1 sm:flex-none bg-blue-700 hover:bg-blue-800 text-white font-bold py-2.5 px-6 min-h-[44px] rounded-xl shadow-sm hover:shadow-md transition-all duration-200 text-sm flex items-center justify-center gap-2">
                                <i class="fa-solid fa-paper-plane"></i>
                                Guardar y Notificar
                            </button>
                            <a href="/panel" class="flex-1 sm:flex-none flex items-center justify-center text-center bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold py-2.5 px-6 min-h-[44px] rounded-xl transition text-sm">
                                Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- ====== SIDEBAR DERECHA (1/3) ====== -->
        <div class="space-y-6">

            <!-- Documentación Adjunta -->
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm">
                <div class="px-5 py-4 border-b border-slate-200 flex items-center gap-3">
                    <div class="w-8 h-8 bg-slate-100 rounded-lg flex items-center justify-center">
                        <i class="fa-solid fa-paperclip text-slate-600 text-sm"></i>
                    </div>
                    <h3 class="font-bold text-slate-900 text-sm">Documentación Adjunta</h3>
                    <% if (attachments && attachments.length > 0) { %>
                    <span class="ml-auto bg-blue-100 text-blue-700 text-xs font-bold px-2 py-0.5 rounded-full"><%= attachments.length %></span>
                    <% } %>
                </div>
                <div class="p-5">
                    <% if (attachments && attachments.length > 0) { %>
                        <ul class="space-y-2">
                            <% attachments.forEach(file => { %>
                                <li class="flex items-center justify-between gap-2 p-2.5 bg-slate-50 rounded-xl border border-slate-200 hover:border-blue-200 hover:bg-blue-50 transition group">
                                    <div class="flex items-center gap-2 overflow-hidden">
                                        <% if (file.filename.match(/\.(jpg|jpeg|png)$/i)) { %>
                                            <div class="w-8 h-8 rounded overflow-hidden shadow-sm flex-shrink-0 border border-slate-200">
                                                <img src="/uploads/<%= file.filename %>" class="w-full h-full object-cover" alt="Preview">
                                            </div>
                                        <% } else { %>
                                            <i class="fa-solid fa-file-pdf text-red-500 text-lg flex-shrink-0"></i>
                                        <% } %>
                                        <span class="text-xs text-slate-700 truncate font-medium" title="<%= file.original_name %>"><%= file.original_name %></span>
                                    </div>
                                    <a href="/uploads/<%= file.filename %>" target="_blank" class="text-slate-400 group-hover:text-blue-600 transition flex-shrink-0" title="Descargar">
                                        <i class="fa-solid fa-download text-sm"></i>
                                    </a>
                                </li>
                            <% }) %>
                        </ul>
                    <% } else { %>
                        <div class="text-center py-6">
                            <i class="fa-regular fa-folder-open text-slate-300 text-3xl mb-2"></i>
                            <p class="text-sm text-slate-400">Sin archivos adjuntos</p>
                        </div>
                    <% } %>
                </div>
            </div>

            <!-- Historial / Timeline -->
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm">
                <div class="px-5 py-4 border-b border-slate-200 flex items-center gap-3">
                    <div class="w-8 h-8 bg-slate-100 rounded-lg flex items-center justify-center">
                        <i class="fa-solid fa-clock-rotate-left text-slate-600 text-sm"></i>
                    </div>
                    <h3 class="font-bold text-slate-900 text-sm">Historial de Cambios</h3>
                </div>
                <div class="p-5">
                    <% if (history && history.length > 0) { %>
                    <div class="space-y-0">
                        <% history.forEach((h, index) => { 
                            let isNote = h.type === 'nota_interna';
                            let hColor = isNote ? 'bg-yellow-500' : 'bg-slate-300';
                            let iconColor = 'text-white';
                            if(!isNote) {
                                if(h.new_status === 'Iniciado') hColor = 'bg-blue-500';
                                if(h.new_status === 'En Revisión') hColor = 'bg-purple-500';
                                if(h.new_status === 'Pendiente de Documentación') hColor = 'bg-orange-500';
                                if(h.new_status === 'Aprobado') hColor = 'bg-green-500';
                                if(h.new_status === 'Rechazado') hColor = 'bg-red-500';
                            }
                        %>
                        <div class="flex gap-3">
                            <!-- Dot -->
                            <div class="flex flex-col items-center">
                                <div class="w-7 h-7 rounded-full <%= hColor %> flex items-center justify-center flex-shrink-0 shadow-sm z-10">
                                    <i class="fa-solid <%= isNote ? 'fa-thumbtack' : 'fa-rotate' %> <%= iconColor %> text-[10px]"></i>
                                </div>
                                <% if (index < history.length - 1) { %>
                                <div class="w-px h-full bg-slate-200 -mt-1 min-h-[30px]"></div>
                                <% } %>
                            </div>
                            <!-- Content -->
                            <div class="flex-1 pb-5 pt-0.5">
                                <div class="flex items-baseline justify-between gap-2 mb-1">
                                    <span class="text-xs font-bold text-slate-800"><%= isNote ? 'Nota Interna' : h.new_status %></span>
                                    <time class="text-xs text-slate-400 whitespace-nowrap"><%= moment.utc(h.created_at).local().format('DD/MM HH:mm') %></time>
                                </div>
                                <% if (!isNote) { %>
                                <p class="text-xs text-slate-500"><i class="fa-solid fa-building text-slate-300 mr-1"></i><%= h.new_area %></p>
                                <% } %>
                                <p class="text-xs text-slate-400 mt-0.5"><%= isNote ? 'Agregada por:' : 'Por:' %> <span class="font-medium text-slate-600"><%= h.user_name %></span></p>
                                
                                <% if (isNote && h.comments) { %>
                                <div class="mt-2 text-xs text-yellow-800 bg-yellow-50 border border-yellow-200 p-2.5 rounded-lg leading-relaxed shadow-sm">
                                    <i class="fa-solid fa-pen text-yellow-500 mr-1"></i><strong>Privado:</strong> <%= h.comments %>
                                </div>
                                <% } else if (h.comments && h.comments !== 'N/A' && h.comments !== 'Trámite ingresado al sistema.' && h.comments !== 'Trámite ingresado por el alumno vía web.') { %>
                                <div class="mt-2 text-xs text-slate-600 bg-slate-50 border border-slate-200 p-2.5 rounded-lg leading-relaxed">
                                    <i class="fa-solid fa-comment text-slate-400 mr-1"></i><%= h.comments %>
                                </div>
                                <% } else if (h.comments) { %>
                                <p class="text-xs text-slate-400 italic mt-1"><%= h.comments %></p>
                                <% } %>
                            </div>
                        </div>
                        <% }) %>
                    </div>
                    <% } else { %>
                        <p class="text-sm text-slate-400 text-center py-6">Sin historial disponible.</p>
                    <% } %>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- Confirmación para estado Rechazado -->
<script>
document.getElementById('updateForm').addEventListener('submit', function(e) {
    const status = this.querySelector('[name="status"]').value;
    if (status === 'Rechazado') {
        if (!confirm('⚠️ ¿Estás seguro de que querés rechazar este expediente?\n\nEsta acción notificará al solicitante por email.')) {
            e.preventDefault();
        }
    }
});
</script>

<%- include('partials/footer') %>
