<%- include('../partials/header') %>

<div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-black text-slate-800 dark:text-white flex items-center gap-2">
                <i class="fa-solid fa-folder-tree text-blue-600"></i> Bandeja de Solicitudes Académicas
            </h1>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Verificación y gestión de solicitudes y documentación de alumnos.</p>
        </div>
        <div class="flex items-center gap-2">
            <span class="text-xs font-bold text-slate-500 bg-slate-100 dark:bg-slate-800 dark:text-slate-300 px-3 py-1.5 rounded-xl border border-slate-200 dark:border-slate-700">
                Total: <%= total %> solicitudes
            </span>
        </div>
    </div>

    <!-- Filtros y Búsqueda -->
    <div class="bg-white dark:bg-slate-800 p-4 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm">
        <form method="GET" action="/backoffice/solicitudes" class="grid grid-cols-1 sm:grid-cols-4 gap-3 text-xs">
            <div>
                <label class="block font-bold text-slate-600 dark:text-slate-300 mb-1">Buscar Alumno</label>
                <input type="text" name="search" value="<%= query.search || '' %>" placeholder="Nombre, DNI o Legajo..." class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-600 dark:text-white">
            </div>
            <div>
                <label class="block font-bold text-slate-600 dark:text-slate-300 mb-1">Tipo de Solicitud</label>
                <select name="tipo" class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-600 dark:text-white">
                    <option value="">Todos los tipos</option>
                    <% tipos.forEach(t => { %>
                    <option value="<%= t.id %>" <%= query.tipo == t.id ? 'selected' : '' %>><%= t.nombre %></option>
                    <% }) %>
                </select>
            </div>
            <div>
                <label class="block font-bold text-slate-600 dark:text-slate-300 mb-1">Estado</label>
                <select name="estado" class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-600 dark:text-white">
                    <option value="">Todos los estados</option>
                    <option value="enviada" <%= query.estado === 'enviada' ? 'selected' : '' %>>Enviada</option>
                    <option value="en_revision" <%= query.estado === 'en_revision' ? 'selected' : '' %>>En revisión</option>
                    <option value="observada" <%= query.estado === 'observada' ? 'selected' : '' %>>Observada</option>
                    <option value="aprobada" <%= query.estado === 'aprobada' ? 'selected' : '' %>>Aprobada</option>
                    <option value="emitida" <%= query.estado === 'emitida' ? 'selected' : '' %>>Emitida</option>
                    <option value="rechazada" <%= query.estado === 'rechazada' ? 'selected' : '' %>>Rechazada</option>
                </select>
            </div>
            <div class="flex items-end gap-2">
                <button type="submit" class="flex-1 bg-blue-700 hover:bg-blue-800 text-white font-bold py-2 px-3 rounded-xl transition flex items-center justify-center gap-1.5 shadow-sm">
                    <i class="fa-solid fa-filter"></i> Filtrar
                </button>
                <a href="/backoffice/solicitudes" class="bg-slate-100 hover:bg-slate-200 dark:bg-slate-700 dark:hover:bg-slate-600 text-slate-600 dark:text-slate-300 font-bold py-2 px-3 rounded-xl transition" title="Limpiar filtros">
                    <i class="fa-solid fa-rotate-left"></i>
                </a>
            </div>
        </form>
    </div>

    <!-- Tabla -->
    <% if (solicitudes.length === 0) { %>
    <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 p-12 text-center shadow-sm">
        <i class="fa-solid fa-inbox text-slate-300 dark:text-slate-600 text-4xl mb-3"></i>
        <p class="text-sm font-bold text-slate-700 dark:text-slate-200">No hay solicitudes que coincidan con el filtro</p>
    </div>
    <% } else { %>
    <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
                <thead class="bg-slate-50 dark:bg-slate-700/50 border-b border-slate-200 dark:border-slate-700 text-slate-500 dark:text-slate-400 uppercase font-bold tracking-wider">
                    <tr>
                        <th class="px-5 py-3.5">ID / Fecha</th>
                        <th class="px-5 py-3.5">Alumno</th>
                        <th class="px-5 py-3.5">Tipo de Solicitud</th>
                        <th class="px-5 py-3.5">Responsable</th>
                        <th class="px-5 py-3.5 text-center">Estado</th>
                        <th class="px-5 py-3.5 text-right">Acción</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-700/50">
                    <% solicitudes.forEach(s => { 
                        const badges = {
                            'borrador': 'bg-slate-100 text-slate-700 border-slate-200 dark:bg-slate-700 dark:text-slate-300',
                            'enviada': 'bg-blue-100 text-blue-800 border-blue-200 dark:bg-blue-900/30 dark:text-blue-300',
                            'en_revision': 'bg-purple-100 text-purple-800 border-purple-200 dark:bg-purple-900/30 dark:text-purple-300',
                            'observada': 'bg-amber-100 text-amber-800 border-amber-200 dark:bg-amber-900/30 dark:text-amber-300',
                            'aprobada': 'bg-green-100 text-green-800 border-green-200 dark:bg-green-900/30 dark:text-green-300',
                            'emitida': 'bg-emerald-100 text-emerald-800 border-emerald-300 dark:bg-emerald-900/30 dark:text-emerald-300',
                            'rechazada': 'bg-red-100 text-red-800 border-red-200 dark:bg-red-900/30 dark:text-red-300'
                        };
                    %>
                    <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/40 transition">
                        <td class="px-5 py-3.5">
                            <span class="font-mono font-bold text-slate-700 dark:text-slate-200">#<%= s.id %></span>
                            <span class="block text-[10px] text-slate-400"><%= moment(s.created_at).format('DD/MM/YYYY HH:mm') %></span>
                        </td>
                        <td class="px-5 py-3.5">
                            <p class="font-bold text-slate-800 dark:text-slate-100"><%= s.alumno_apellido %>, <%= s.alumno_nombre %></p>
                            <p class="text-[11px] text-slate-500 dark:text-slate-400">Legajo: <%= s.legajo %> | DNI: <%= s.dni %></p>
                        </td>
                        <td class="px-5 py-3.5">
                            <p class="font-semibold text-slate-700 dark:text-slate-200"><%= s.tipo_nombre %></p>
                            <span class="text-[10px] text-slate-400 uppercase tracking-wider"><%= s.tipo_modalidad === 'emision' ? 'Emisión' : 'Presentación' %></span>
                        </td>
                        <td class="px-5 py-3.5 text-slate-600 dark:text-slate-300">
                            <%= s.asignado_nombre || '<span class="text-slate-400 italic">Sin asignar</span>' %>
                        </td>
                        <td class="px-5 py-3.5 text-center">
                            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-bold border <%= badges[s.estado] || 'bg-slate-100 text-slate-700' %>">
                                <%= s.estado %>
                            </span>
                        </td>
                        <td class="px-5 py-3.5 text-right">
                            <a href="/backoffice/solicitudes/<%= s.id %>" class="inline-flex items-center gap-1 bg-blue-600 hover:bg-blue-700 text-white font-bold px-3 py-1.5 rounded-lg text-xs transition">
                                Ver Detalle <i class="fa-solid fa-chevron-right text-[9px]"></i>
                            </a>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
    <% } %>
</div>

<%- include('../partials/footer') %>
