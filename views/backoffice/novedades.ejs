<%- include('../partials/header') %>

<%
    const campo = 'w-full text-xs px-3 py-2 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-600 dark:text-white';
    const label = 'block font-bold text-slate-700 dark:text-slate-300 mb-1';
    const audiencias = { publico: 'Sólo público', alumnos: 'Sólo alumnos', ambos: 'Público y alumnos' };
    const audColor = { publico: 'bg-sky-100 text-sky-800', alumnos: 'bg-violet-100 text-violet-800', ambos: 'bg-slate-100 text-slate-700' };
%>

<div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-black text-slate-800 dark:text-white flex items-center gap-2">
                <i class="fa-solid fa-bullhorn text-blue-600 dark:text-blue-400"></i> Novedades y Avisos Institucionales
            </h1>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Cada novedad se publica en el inicio público, en el portal del alumno o en ambos, según la audiencia que elijas.</p>
        </div>
        <button onclick="document.getElementById('modalNuevaNovedad').classList.remove('hidden')" class="bg-blue-700 hover:bg-blue-800 text-white font-bold px-4 py-2 rounded-xl text-xs transition inline-flex items-center gap-2 self-start sm:self-auto shadow-sm">
            <i class="fa-solid fa-plus"></i> Publicar Novedad
        </button>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
        <% if (novedades.length === 0) { %>
        <div class="lg:col-span-2 bg-white dark:bg-slate-800 p-8 text-center rounded-2xl border border-slate-200 dark:border-slate-700 dark:text-slate-100">
            <p class="text-xs text-slate-400">No hay novedades publicadas.</p>
        </div>
        <% } %>
        <% novedades.forEach(n => { const aud = n.audiencia || 'ambos'; %>
        <div class="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm <%= n.activo ? '' : 'opacity-60' %>">
            <div class="flex items-center justify-between gap-2 mb-2">
                <span class="text-[10px] text-slate-400 font-mono"><%= moment(n.fecha_publicacion).format('DD/MM/YYYY') %></span>
                <div class="flex items-center gap-1.5">
                    <% if (n.destacada) { %><span class="text-[10px] font-bold bg-amber-100 text-amber-800 px-2 py-0.5 rounded-md dark:bg-amber-900/30 dark:text-amber-300"><i class="fa-solid fa-star text-[9px]"></i> Destacada</span><% } %>
                    <span class="text-[10px] font-bold px-2 py-0.5 rounded-md <%= audColor[aud] %>"><%= audiencias[aud] %></span>
                    <% if (!n.activo) { %><span class="text-[10px] font-bold bg-slate-200 text-slate-600 px-2 py-0.5 rounded-md dark:bg-slate-600 dark:text-slate-300">Oculta</span><% } %>
                </div>
            </div>
            <h3 class="font-bold text-slate-800 dark:text-slate-100 text-sm mb-1"><%= n.titulo %></h3>
            <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed line-clamp-3"><%= n.cuerpo %></p>

            <details class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-700">
                <summary class="text-xs font-bold text-blue-600 cursor-pointer select-none dark:text-blue-400">Editar</summary>
                <form action="/backoffice/novedades/editar/<%= n.id %>" method="POST" class="space-y-3 text-xs mt-3">
                    <div><label class="<%= label %>">Título</label><input type="text" name="titulo" required value="<%= n.titulo %>" class="<%= campo %>"></div>
                    <div><label class="<%= label %>">Contenido</label><textarea name="cuerpo" rows="4" class="<%= campo %>"><%= n.cuerpo %></textarea></div>
                    <div>
                        <label class="<%= label %>">Se muestra a</label>
                        <select name="audiencia" class="<%= campo %>">
                            <% Object.keys(audiencias).forEach(k => { %><option value="<%= k %>" <%= aud === k ? 'selected' : '' %>><%= audiencias[k] %></option><% }) %>
                        </select>
                    </div>
                    <div class="flex items-center gap-5">
                        <label class="flex items-center gap-2 font-bold text-slate-700 dark:text-slate-300"><input type="checkbox" name="destacada" value="1" <%= n.destacada ? 'checked' : '' %> class="rounded text-blue-600 dark:text-blue-400"> Destacada</label>
                        <label class="flex items-center gap-2 font-bold text-slate-700 dark:text-slate-300"><input type="checkbox" name="activo" value="1" <%= n.activo ? 'checked' : '' %> class="rounded text-blue-600 dark:text-blue-400"> Visible</label>
                    </div>
                    <div class="flex items-center justify-between">
                        <button type="submit" class="bg-blue-700 hover:bg-blue-800 text-white font-bold px-4 py-1.5 rounded-xl">Guardar</button>
                        <button type="submit" formaction="/backoffice/novedades/eliminar/<%= n.id %>" formnovalidate onclick="return confirm('¿Eliminar esta novedad?')" class="text-red-500 hover:text-red-700 font-semibold flex items-center gap-1 dark:text-red-400 dark:hover:text-red-300">
                            <i class="fa-solid fa-trash-can"></i> Eliminar
                        </button>
                    </div>
                </form>
            </details>
        </div>
        <% }) %>
    </div>
</div>

<!-- Modal Nueva Novedad -->
<div id="modalNuevaNovedad" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm">
    <div class="bg-white dark:bg-slate-800 rounded-2xl p-6 max-w-lg w-full border border-slate-200 dark:border-slate-700 shadow-2xl dark:text-slate-100">
        <div class="flex justify-between items-center mb-4">
            <h3 class="text-sm font-bold text-slate-800 dark:text-white">Publicar Nueva Novedad</h3>
            <button onclick="document.getElementById('modalNuevaNovedad').classList.add('hidden')" class="text-slate-400 hover:text-slate-600"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <form action="/backoffice/novedades/nuevo" method="POST" class="space-y-3 text-xs">
            <div><label class="<%= label %>">Título</label><input type="text" name="titulo" required placeholder="Título del aviso..." class="<%= campo %>"></div>
            <div><label class="<%= label %>">Contenido / Cuerpo</label><textarea name="cuerpo" rows="4" required placeholder="Texto del comunicado..." class="<%= campo %>"></textarea></div>
            <div>
                <label class="<%= label %>">Se muestra a</label>
                <select name="audiencia" class="<%= campo %>">
                    <% Object.keys(audiencias).forEach(k => { %><option value="<%= k %>" <%= k === 'ambos' ? 'selected' : '' %>><%= audiencias[k] %></option><% }) %>
                </select>
            </div>
            <div class="flex items-center gap-2 pt-1">
                <input type="checkbox" id="destacada" name="destacada" value="1" class="rounded text-blue-600 focus:ring-blue-500">
                <label for="destacada" class="font-bold text-slate-700 dark:text-slate-300">Marcar como destacada</label>
            </div>
            <div class="pt-3 flex justify-end gap-2">
                <button type="button" onclick="document.getElementById('modalNuevaNovedad').classList.add('hidden')" class="px-4 py-2 bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-300 font-bold rounded-xl">Cancelar</button>
                <button type="submit" class="px-4 py-2 bg-blue-700 hover:bg-blue-800 text-white font-bold rounded-xl shadow-sm">Publicar</button>
            </div>
        </form>
    </div>
</div>

<%- include('../partials/footer') %>
