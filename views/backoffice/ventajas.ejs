<%- include('../partials/header') %>

<%
    const campo = 'w-full text-xs px-3 py-2 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-600 dark:text-white';
    const label = 'block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1';
    const iconos = ['fa-award', 'fa-chalkboard-user', 'fa-clock', 'fa-hand-holding-heart', 'fa-laptop', 'fa-piggy-bank', 'fa-briefcase', 'fa-users', 'fa-book-open', 'fa-handshake', 'fa-location-dot', 'fa-medal', 'fa-star', 'fa-certificate', 'fa-graduation-cap'];
%>

<div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-black text-slate-800 dark:text-white flex items-center gap-2">
                <i class="fa-solid fa-award text-blue-600 dark:text-blue-400"></i> Ventajas de la Institución
            </h1>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Se muestran en la sección <a href="/#ventajas" target="_blank" class="text-blue-600 hover:underline dark:text-blue-400">“Ventajas de estudiar en PUSAP”</a> del inicio público.</p>
        </div>
        <button onclick="document.getElementById('modalNuevaVentaja').classList.remove('hidden')" class="bg-blue-700 hover:bg-blue-800 text-white font-bold px-4 py-2 rounded-xl text-xs transition inline-flex items-center gap-2 self-start sm:self-auto shadow-sm">
            <i class="fa-solid fa-plus"></i> Agregar ventaja
        </button>
    </div>

    <datalist id="listaIconos">
        <% iconos.forEach(i => { %><option value="<%= i %>"></option><% }) %>
    </datalist>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
        <% if (ventajas.length === 0) { %>
        <div class="lg:col-span-2 bg-white dark:bg-slate-800 p-8 text-center rounded-2xl border border-slate-200 dark:border-slate-700 dark:text-slate-100">
            <p class="text-xs text-slate-400">No hay ventajas cargadas. La sección no se muestra en el sitio hasta que agregues alguna.</p>
        </div>
        <% } %>
        <% ventajas.forEach(v => { %>
        <form action="/backoffice/ventajas/editar/<%= v.id %>" method="POST" class="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm space-y-3 <%= v.activo ? '' : 'opacity-60' %>">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-blue-100 text-blue-700 flex items-center justify-center shrink-0 dark:bg-blue-900/30 dark:text-blue-400"><i class="fa-solid <%= v.icono %>"></i></div>
                <input type="text" name="titulo" required maxlength="120" value="<%= v.titulo %>" class="<%= campo %> font-bold">
            </div>
            <textarea name="descripcion" rows="2" maxlength="500" class="<%= campo %>"><%= v.descripcion %></textarea>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="<%= label %>">Ícono (FontAwesome)</label>
                    <input type="text" name="icono" list="listaIconos" value="<%= v.icono %>" pattern="fa-[a-z0-9-]+" class="<%= campo %>">
                </div>
                <div>
                    <label class="<%= label %>">Orden</label>
                    <input type="number" name="orden" value="<%= v.orden %>" class="<%= campo %>">
                </div>
            </div>
            <div class="flex items-center justify-between pt-1">
                <label class="flex items-center gap-2 text-xs font-bold text-slate-700 dark:text-slate-300">
                    <input type="checkbox" name="activo" value="1" <%= v.activo ? 'checked' : '' %> class="rounded text-blue-600 focus:ring-blue-500 dark:text-blue-400"> Visible
                </label>
                <div class="flex items-center gap-3">
                    <button type="submit" class="bg-blue-700 hover:bg-blue-800 text-white font-bold px-4 py-1.5 rounded-xl text-xs">Guardar</button>
                    <button type="submit" formaction="/backoffice/ventajas/eliminar/<%= v.id %>" formnovalidate onclick="return confirm('¿Eliminar esta ventaja?')" class="text-red-500 hover:text-red-700 text-xs font-semibold dark:text-red-400 dark:hover:text-red-300">
                        <i class="fa-solid fa-trash-can"></i>
                    </button>
                </div>
            </div>
        </form>
        <% }) %>
    </div>
</div>

<!-- Modal Nueva Ventaja -->
<div id="modalNuevaVentaja" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm">
    <div class="bg-white dark:bg-slate-800 rounded-2xl p-6 max-w-lg w-full border border-slate-200 dark:border-slate-700 shadow-2xl dark:text-slate-100">
        <div class="flex justify-between items-center mb-4">
            <h3 class="text-sm font-bold text-slate-800 dark:text-white">Agregar ventaja</h3>
            <button onclick="document.getElementById('modalNuevaVentaja').classList.add('hidden')" class="text-slate-400 hover:text-slate-600"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <form action="/backoffice/ventajas/nuevo" method="POST" class="space-y-3">
            <div>
                <label class="<%= label %>">Título</label>
                <input type="text" name="titulo" required maxlength="120" class="<%= campo %>" placeholder="Ej: Convenios con empresas">
            </div>
            <div>
                <label class="<%= label %>">Descripción</label>
                <textarea name="descripcion" rows="3" maxlength="500" class="<%= campo %>"></textarea>
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="<%= label %>">Ícono (FontAwesome)</label>
                    <input type="text" name="icono" list="listaIconos" value="fa-star" pattern="fa-[a-z0-9-]+" class="<%= campo %>">
                </div>
                <div>
                    <label class="<%= label %>">Orden</label>
                    <input type="number" name="orden" value="0" class="<%= campo %>">
                </div>
            </div>
            <div class="pt-3 flex justify-end gap-2">
                <button type="button" onclick="document.getElementById('modalNuevaVentaja').classList.add('hidden')" class="px-4 py-2 bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-300 font-bold rounded-xl text-xs">Cancelar</button>
                <button type="submit" class="px-4 py-2 bg-blue-700 hover:bg-blue-800 text-white font-bold rounded-xl text-xs shadow-sm">Agregar</button>
            </div>
        </form>
    </div>
</div>

<%- include('../partials/footer') %>
