<%- include('../partials/header') %>

<%
    const campo = 'w-full text-xs px-3 py-2 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-600 dark:text-white';
    const label = 'block font-bold text-slate-700 dark:text-slate-300 mb-1';
    const audiencias = { publico: 'Sólo público', alumnos: 'Sólo alumnos', ambos: 'Público y alumnos' };
    const audColor = { publico: 'bg-sky-100 text-sky-800', alumnos: 'bg-violet-100 text-violet-800', ambos: 'bg-slate-100 text-slate-700' };
%>

<div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-black text-slate-800 dark:text-white flex items-center gap-2">
                <i class="fa-solid fa-circle-question text-blue-600 dark:text-blue-400"></i> Preguntas Frecuentes (FAQs)
            </h1>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Cada pregunta se muestra en el inicio público, en el portal del alumno o en ambos.</p>
        </div>
        <button onclick="document.getElementById('modalNuevoFaq').classList.remove('hidden')" class="bg-blue-700 hover:bg-blue-800 text-white font-bold px-4 py-2 rounded-xl text-xs transition inline-flex items-center gap-2 self-start sm:self-auto shadow-sm">
            <i class="fa-solid fa-plus"></i> Nueva Pregunta
        </button>
    </div>

    <div class="space-y-3">
        <% if (faqs.length === 0) { %>
        <div class="bg-white dark:bg-slate-800 p-8 text-center rounded-2xl border border-slate-200 dark:border-slate-700 dark:text-slate-100">
            <p class="text-xs text-slate-400">No hay preguntas cargadas.</p>
        </div>
        <% } %>
        <% faqs.forEach(f => { const aud = f.audiencia || 'ambos'; %>
        <div class="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm <%= f.activo ? '' : 'opacity-60' %>">
            <div class="flex flex-wrap items-center gap-2 mb-2">
                <span class="text-[10px] font-bold uppercase tracking-wider bg-blue-100 text-blue-800 dark:bg-blue-900/40 dark:text-blue-300 px-2 py-0.5 rounded-md"><%= f.categoria %></span>
                <span class="text-[10px] font-bold px-2 py-0.5 rounded-md <%= audColor[aud] %>"><%= audiencias[aud] %></span>
                <% if (!f.activo) { %><span class="text-[10px] font-bold bg-slate-200 text-slate-600 px-2 py-0.5 rounded-md dark:bg-slate-600 dark:text-slate-300">Oculta</span><% } %>
                <span class="text-[10px] text-slate-400">Orden: <%= f.orden %></span>
            </div>
            <h3 class="font-bold text-slate-800 dark:text-slate-100 text-sm"><%= f.pregunta %></h3>
            <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed mt-1 line-clamp-2"><%= f.respuesta %></p>

            <details class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-700">
                <summary class="text-xs font-bold text-blue-600 cursor-pointer select-none dark:text-blue-400">Editar</summary>
                <form action="/backoffice/faqs/editar/<%= f.id %>" method="POST" class="space-y-3 text-xs mt-3">
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                        <div><label class="<%= label %>">Categoría</label><input type="text" name="categoria" value="<%= f.categoria %>" class="<%= campo %>"></div>
                        <div>
                            <label class="<%= label %>">Se muestra a</label>
                            <select name="audiencia" class="<%= campo %>">
                                <% Object.keys(audiencias).forEach(k => { %><option value="<%= k %>" <%= aud === k ? 'selected' : '' %>><%= audiencias[k] %></option><% }) %>
                            </select>
                        </div>
                        <div><label class="<%= label %>">Orden</label><input type="number" name="orden" value="<%= f.orden %>" class="<%= campo %>"></div>
                    </div>
                    <div><label class="<%= label %>">Pregunta</label><input type="text" name="pregunta" required value="<%= f.pregunta %>" class="<%= campo %>"></div>
                    <div><label class="<%= label %>">Respuesta</label><textarea name="respuesta" rows="4" required class="<%= campo %>"><%= f.respuesta %></textarea></div>
                    <label class="flex items-center gap-2 font-bold text-slate-700 dark:text-slate-300"><input type="checkbox" name="activo" value="1" <%= f.activo ? 'checked' : '' %> class="rounded text-blue-600 dark:text-blue-400"> Visible</label>
                    <div class="flex items-center justify-between">
                        <button type="submit" class="bg-blue-700 hover:bg-blue-800 text-white font-bold px-4 py-1.5 rounded-xl">Guardar</button>
                        <button type="submit" formaction="/backoffice/faqs/eliminar/<%= f.id %>" formnovalidate onclick="return confirm('¿Seguro que querés eliminar esta pregunta?')" class="text-red-500 hover:text-red-700 font-semibold flex items-center gap-1 dark:text-red-400 dark:hover:text-red-300">
                            <i class="fa-solid fa-trash-can"></i> Eliminar
                        </button>
                    </div>
                </form>
            </details>
        </div>
        <% }) %>
    </div>
</div>

<!-- Modal Nueva FAQ -->
<div id="modalNuevoFaq" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm">
    <div class="bg-white dark:bg-slate-800 rounded-2xl p-6 max-w-lg w-full border border-slate-200 dark:border-slate-700 shadow-2xl dark:text-slate-100">
        <div class="flex justify-between items-center mb-4">
            <h3 class="text-sm font-bold text-slate-800 dark:text-white">Nueva Pregunta Frecuente</h3>
            <button onclick="document.getElementById('modalNuevoFaq').classList.add('hidden')" class="text-slate-400 hover:text-slate-600"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <form action="/backoffice/faqs/nuevo" method="POST" class="space-y-3 text-xs">
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <div><label class="<%= label %>">Categoría</label><input type="text" name="categoria" value="General" class="<%= campo %>"></div>
                <div>
                    <label class="<%= label %>">Se muestra a</label>
                    <select name="audiencia" class="<%= campo %>">
                        <% Object.keys(audiencias).forEach(k => { %><option value="<%= k %>" <%= k === 'ambos' ? 'selected' : '' %>><%= audiencias[k] %></option><% }) %>
                    </select>
                </div>
                <div><label class="<%= label %>">Orden</label><input type="number" name="orden" value="0" class="<%= campo %>"></div>
            </div>
            <div><label class="<%= label %>">Pregunta</label><input type="text" name="pregunta" required class="<%= campo %>"></div>
            <div><label class="<%= label %>">Respuesta</label><textarea name="respuesta" rows="4" required class="<%= campo %>"></textarea></div>
            <div class="pt-3 flex justify-end gap-2">
                <button type="button" onclick="document.getElementById('modalNuevoFaq').classList.add('hidden')" class="px-4 py-2 bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-300 font-bold rounded-xl">Cancelar</button>
                <button type="submit" class="px-4 py-2 bg-blue-700 hover:bg-blue-800 text-white font-bold rounded-xl shadow-sm">Guardar</button>
            </div>
        </form>
    </div>
</div>

<%- include('../partials/footer') %>
