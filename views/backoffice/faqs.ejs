<%- include('../partials/header') %>

<div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-black text-slate-800 dark:text-white flex items-center gap-2">
                <i class="fa-solid fa-circle-question text-blue-600"></i> Preguntas Frecuentes (FAQs)
            </h1>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Administrá las preguntas y respuestas públicas del portal.</p>
        </div>
        <button onclick="document.getElementById('modalNuevoFaq').classList.remove('hidden')" class="bg-blue-700 hover:bg-blue-800 text-white font-bold px-4 py-2 rounded-xl text-xs transition inline-flex items-center gap-2 self-start sm:self-auto shadow-sm">
            <i class="fa-solid fa-plus"></i> Nueva Pregunta
        </button>
    </div>

    <!-- Lista de FAQs -->
    <div class="space-y-3">
        <% faqs.forEach(f => { %>
        <div class="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm flex flex-col sm:flex-row sm:items-start justify-between gap-4">
            <div class="space-y-2 flex-1">
                <div class="flex items-center gap-2">
                    <span class="text-[10px] font-bold uppercase tracking-wider bg-blue-100 text-blue-800 dark:bg-blue-900/40 dark:text-blue-300 px-2 py-0.5 rounded-md">
                        <%= f.categoria %>
                    </span>
                    <% if (!f.activo) { %>
                    <span class="text-[10px] font-bold bg-slate-100 text-slate-600 px-2 py-0.5 rounded-md">Inactiva</span>
                    <% } %>
                    <span class="text-[10px] text-slate-400">Orden: <%= f.orden %></span>
                </div>
                <h3 class="font-bold text-slate-800 dark:text-slate-100 text-sm"><%= f.pregunta %></h3>
                <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed"><%= f.respuesta %></p>
            </div>
            <div class="flex items-center gap-2 shrink-0">
                <form action="/backoffice/faqs/eliminar/<%= f.id %>" method="POST" onsubmit="return confirm('¿Seguro que querés eliminar esta pregunta?')">
                    <button type="submit" class="text-red-500 hover:text-red-700 p-2 rounded-lg hover:bg-red-50 dark:hover:bg-slate-700 transition" title="Eliminar">
                        <i class="fa-solid fa-trash-can"></i>
                    </button>
                </form>
            </div>
        </div>
        <% }) %>
    </div>
</div>

<!-- Modal Nueva FAQ -->
<div id="modalNuevoFaq" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm">
    <div class="bg-white dark:bg-slate-800 rounded-2xl p-6 max-w-lg w-full border border-slate-200 dark:border-slate-700 shadow-2xl">
        <div class="flex justify-between items-center mb-4">
            <h3 class="text-sm font-bold text-slate-800 dark:text-white">Nueva Pregunta Frecuente</h3>
            <button onclick="document.getElementById('modalNuevoFaq').classList.add('hidden')" class="text-slate-400 hover:text-slate-600">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <form action="/backoffice/faqs/nuevo" method="POST" class="space-y-3 text-xs">
            <div>
                <label class="block font-bold text-slate-700 dark:text-slate-300 mb-1">Categoría</label>
                <input type="text" name="categoria" required placeholder="Ej: Inscripción, Pagos, Trámites..." class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl focus:bg-white dark:text-white">
            </div>
            <div>
                <label class="block font-bold text-slate-700 dark:text-slate-300 mb-1">Pregunta</label>
                <input type="text" name="pregunta" required placeholder="¿Cómo me inscribo...?" class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl focus:bg-white dark:text-white">
            </div>
            <div>
                <label class="block font-bold text-slate-700 dark:text-slate-300 mb-1">Respuesta</label>
                <textarea name="respuesta" rows="3" required placeholder="Explicación clara..." class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl focus:bg-white dark:text-white"></textarea>
            </div>
            <div>
                <label class="block font-bold text-slate-700 dark:text-slate-300 mb-1">Orden de aparición</label>
                <input type="number" name="orden" value="1" class="w-24 px-3 py-2 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl focus:bg-white dark:text-white">
            </div>
            <div class="pt-2 flex justify-end gap-2">
                <button type="button" onclick="document.getElementById('modalNuevoFaq').classList.add('hidden')" class="px-4 py-2 bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-300 font-bold rounded-xl">Cancelar</button>
                <button type="submit" class="px-4 py-2 bg-blue-700 hover:bg-blue-800 text-white font-bold rounded-xl shadow-sm">Guardar Pregunta</button>
            </div>
        </form>
    </div>
</div>

<%- include('../partials/footer') %>
