<%- include('../partials/header') %>

<%
    const campo = 'w-full text-xs px-3 py-2 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-600 dark:text-white';
    const grupos = [
        { titulo: 'Portada del sitio',        icono: 'fa-house',       claves: ['hero_titulo', 'hero_subtitulo'] },
        { titulo: 'Sede y atención presencial', icono: 'fa-location-dot', claves: ['direccion', 'horario_presencial'] },
        { titulo: 'Canales de contacto',      icono: 'fa-headset',     claves: ['telefono', 'email', 'whatsapp', 'whatsapp_visible'] }
    ];
%>

<div class="max-w-3xl mx-auto space-y-6">
    <div>
        <h1 class="text-2xl font-black text-slate-800 dark:text-white flex items-center gap-2">
            <i class="fa-solid fa-address-card text-blue-600 dark:text-blue-400"></i> Datos Institucionales
        </h1>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Textos y datos de contacto que se muestran en el inicio, el pie de página, Contacto y el portal del alumno. Si vaciás un campo, vuelve al valor original.</p>
    </div>

    <% if (ok) { %>
    <div class="bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs rounded-xl p-3 flex items-center gap-2 dark:bg-emerald-900/30 dark:border-emerald-800 dark:text-emerald-300"><i class="fa-solid fa-circle-check"></i> Cambios guardados y publicados.</div>
    <% } %>
    <% if (error) { %>
    <div class="bg-red-50 border border-red-200 text-red-700 text-xs rounded-xl p-3 flex items-center gap-2 dark:bg-red-900/30 dark:border-red-800 dark:text-red-400"><i class="fa-solid fa-circle-exclamation"></i> No se pudieron guardar los cambios. Probá de nuevo.</div>
    <% } %>

    <form action="/backoffice/contenido" method="POST" class="space-y-6">
        <% grupos.forEach(g => { %>
        <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm space-y-4 dark:text-slate-100">
            <h2 class="text-sm font-bold text-slate-800 dark:text-white uppercase tracking-wider flex items-center gap-2">
                <i class="fa-solid <%= g.icono %> text-blue-600"></i> <%= g.titulo %>
            </h2>
            <% g.claves.forEach(k => { const c = campos[k]; %>
            <div>
                <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1" for="<%= k %>"><%= c.etiqueta %></label>
                <% if (c.largo) { %>
                <textarea id="<%= k %>" name="<%= k %>" rows="2" maxlength="500" class="<%= campo %>"><%= valores[k] %></textarea>
                <% } else { %>
                <input id="<%= k %>" type="text" name="<%= k %>" maxlength="500" value="<%= valores[k] %>" class="<%= campo %>">
                <% } %>
                <% if (c.ayuda) { %><p class="text-[10px] text-slate-400 mt-1"><%= c.ayuda %></p><% } %>
            </div>
            <% }) %>
        </div>
        <% }) %>

        <div class="flex items-center justify-between gap-4">
            <p class="text-[11px] text-slate-400">El aviso destacado y el mensaje de bienvenida se editan en <a href="/panel/config" class="text-blue-600 hover:underline dark:text-blue-400">Configuración</a>.</p>
            <button type="submit" class="px-5 py-2 bg-blue-700 hover:bg-blue-800 text-white font-bold rounded-xl text-xs shadow-sm">Guardar y publicar</button>
        </div>
    </form>
</div>

<%- include('../partials/footer') %>
