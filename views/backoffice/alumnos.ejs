<%- include('../partials/header') %>

<div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-black text-slate-800 dark:text-white flex items-center gap-2">
                <i class="fa-solid fa-user-graduate text-blue-600 dark:text-blue-400"></i> Padrón de Alumnos
            </h1>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Gestión de estudiantes, inscripción a carreras y acceso al portal del alumno.</p>
        </div>
        <div class="flex items-center gap-2">
            <button onclick="openNuevoAlumnoModal()" class="bg-blue-700 hover:bg-blue-800 text-white font-bold px-4 py-2.5 rounded-xl text-xs transition flex items-center gap-2 shadow-sm">
                <i class="fa-solid fa-user-plus"></i> Registrar Nuevo Alumno
            </button>
        </div>
    </div>

    <!-- Alertas de éxito o error -->
    <% if (typeof success !== 'undefined' && success && token) { %>
    <div class="bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-300 dark:border-emerald-700 rounded-2xl p-5 shadow-sm animate-[fadeIn_0.3s_ease]">
        <div class="flex items-start justify-between gap-4">
            <div class="flex items-start gap-3">
                <div class="w-10 h-10 rounded-xl bg-emerald-100 dark:bg-emerald-900 text-emerald-700 dark:text-emerald-300 flex items-center justify-center font-bold text-lg shrink-0 mt-0.5">
                    <i class="fa-solid fa-key"></i>
                </div>
                <div>
                    <h4 class="font-extrabold text-emerald-900 dark:text-emerald-200 text-sm">
                        <%= success === 'creado' ? '¡Alumno registrado y enlace de activación generado!' : '¡Nuevo enlace de activación generado con éxito!' %>
                    </h4>
                    <p class="text-xs text-emerald-700 dark:text-emerald-300 mt-0.5">
                        Alumno: <strong class="text-emerald-900 dark:text-white"><%= alumnoNombre || 'Estudiante' %></strong>. Compartile el siguiente enlace para que cree su contraseña de acceso al portal (válido por 7 días):
                    </p>
                    <div class="mt-3 flex items-center gap-2 flex-wrap">
                        <input type="text" id="activationLinkInput" readonly value="<%= req.protocol %>://<%= req.get('host') %>/activar/<%= token %>" class="px-3 py-2 bg-white dark:bg-slate-800 border border-emerald-300 dark:border-emerald-700 rounded-xl text-xs font-mono text-slate-800 dark:text-slate-200 w-full sm:w-96 select-all dark:placeholder-slate-400">
                        <button type="button" onclick="copyActivationLink()" id="copyLinkBtn" class="bg-emerald-700 hover:bg-emerald-800 text-white font-bold px-4 py-2 rounded-xl text-xs transition flex items-center gap-1.5 shadow-sm">
                            <i class="fa-regular fa-copy"></i> Copiar Enlace
                        </button>
                    </div>
                </div>
            </div>
            <a href="/backoffice/alumnos" class="text-emerald-500 hover:text-emerald-700 p-1 dark:text-emerald-400 dark:hover:text-emerald-300">
                <i class="fa-solid fa-xmark"></i>
            </a>
        </div>
    </div>
    <% } %>

    <% if (typeof error !== 'undefined' && error) { %>
    <div class="bg-red-50 dark:bg-red-950/40 border border-red-200 dark:border-red-800 text-red-800 dark:text-red-200 rounded-2xl p-4 flex items-center justify-between shadow-sm">
        <div class="flex items-center gap-3">
            <i class="fa-solid fa-circle-exclamation text-red-500 text-lg dark:text-red-400"></i>
            <p class="text-xs font-bold"><%= decodeURIComponent(error) %></p>
        </div>
        <a href="/backoffice/alumnos" class="text-red-400 hover:text-red-600 p-1">
            <i class="fa-solid fa-xmark"></i>
        </a>
    </div>
    <% } %>

    <% const avisosOk = { editado: 'Datos del alumno guardados.', bloqueado: 'Acceso al portal bloqueado. El alumno ya no puede ingresar.', habilitado: 'Acceso al portal habilitado.', eliminado: 'Alumno dado de baja.' }; %>
    <% if (ok && avisosOk[ok]) { %>
    <div class="bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs rounded-xl p-3 flex items-center gap-2 dark:bg-emerald-900/30 dark:border-emerald-800 dark:text-emerald-300"><i class="fa-solid fa-circle-check"></i> <%= avisosOk[ok] %></div>
    <% } %>

    <!-- Buscador y métricas rápidas -->
    <div class="bg-white dark:bg-slate-800 p-4 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-3 dark:text-slate-100">
        <form method="GET" action="/backoffice/alumnos" class="flex gap-2 w-full sm:w-auto flex-1">
            <div class="relative flex-1">
                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                    <i class="fa-solid fa-magnifying-glass text-xs"></i>
                </div>
                <input type="text" name="search" value="<%= query.search || '' %>" placeholder="Buscar por Nombre, Apellido, DNI o Legajo..." class="w-full text-xs pl-9 pr-4 py-2.5 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-600 dark:text-white dark:placeholder-slate-400 dark:focus:bg-slate-800">
            </div>
            <button type="submit" class="bg-blue-700 hover:bg-blue-800 text-white font-bold px-4 py-2.5 rounded-xl text-xs transition flex items-center gap-1.5 shadow-sm">
                Buscar
            </button>
            <% if (query.search) { %>
            <a href="/backoffice/alumnos" class="bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 font-bold px-3 py-2.5 rounded-xl text-xs transition flex items-center" title="Limpiar filtro">
                <i class="fa-solid fa-rotate-left"></i>
            </a>
            <% } %>
        </form>
        <span class="text-xs font-bold text-slate-500 dark:text-slate-400 bg-slate-100 dark:bg-slate-700 px-3 py-1.5 rounded-xl whitespace-nowrap">
            <%= alumnos.length %> alumno<%= alumnos.length !== 1 ? 's' : '' %> registrado<%= alumnos.length !== 1 ? 's' : '' %>
        </span>
    </div>

    <!-- Lista de Alumnos -->
    <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm overflow-hidden dark:text-slate-100">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
                <thead class="bg-slate-50 dark:bg-slate-700/50 border-b border-slate-200 dark:border-slate-700 text-slate-500 dark:text-slate-400 uppercase font-bold tracking-wider">
                    <tr>
                        <th class="px-5 py-3.5">Legajo / DNI</th>
                        <th class="px-5 py-3.5">Alumno</th>
                        <th class="px-5 py-3.5">Carrera(s)</th>
                        <th class="px-5 py-3.5">Contacto</th>
                        <th class="px-5 py-3.5 text-center">Acceso Portal</th>
                        <th class="px-5 py-3.5 text-right">Acciones</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-700/50">
                    <% if (alumnos.length === 0) { %>
                    <tr>
                        <td colspan="6" class="px-5 py-12 text-center text-slate-400">
                            <i class="fa-solid fa-user-graduate text-3xl mb-2 block opacity-40"></i>
                            No se encontraron alumnos registrados con ese criterio.
                        </td>
                    </tr>
                    <% } %>
                    <% alumnos.forEach(a => { %>
                    <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/40 transition">
                        <td class="px-5 py-3.5">
                            <span class="font-mono font-bold text-blue-700 dark:text-blue-400 block"><%= a.legajo %></span>
                            <span class="text-[11px] text-slate-400">DNI <%= a.dni %></span>
                        </td>
                        <td class="px-5 py-3.5 font-bold text-slate-800 dark:text-slate-100">
                            <%= a.apellido %>, <%= a.nombre %>
                        </td>
                        <td class="px-5 py-3.5 text-slate-600 dark:text-slate-300">
                            <%= a.carreras || '<span class="text-slate-400 italic">Sin carreras asignadas</span>' %>
                        </td>
                        <td class="px-5 py-3.5 text-slate-500 dark:text-slate-400">
                            <p class="font-medium text-slate-700 dark:text-slate-300"><%= a.email || '-' %></p>
                            <p class="text-[10px]"><%= a.telefono || '' %></p>
                        </td>
                        <td class="px-5 py-3.5 text-center">
                            <% if (a.cuenta_activa === 1) { %>
                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10px] font-bold bg-green-100 text-green-800 dark:bg-green-950/40 dark:text-green-300 border border-green-200 dark:border-green-800">
                                <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span> Activo
                            </span>
                            <% } else if (a.cuenta_activa === 0) { %>
                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800 dark:bg-amber-950/40 dark:text-amber-300 border border-amber-200 dark:border-amber-800">
                                Pendiente activación
                            </span>
                            <% } else { %>
                            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[10px] font-bold bg-slate-100 text-slate-600 dark:bg-slate-700 dark:text-slate-300">
                                Sin usuario
                            </span>
                            <% } %>
                        </td>
                        <td class="px-5 py-3.5 text-right whitespace-nowrap">
                            <button type="button" data-alumno="<%= JSON.stringify({ id: a.id, legajo: a.legajo, dni: a.dni, nombre: a.nombre, apellido: a.apellido, email: a.email, telefono: a.telefono, direccion: a.direccion, carreras: (a.carreras_ids || '').split(',').filter(Boolean).map(Number), historial: a.historial }) %>" onclick="abrirEditarAlumno(this)" class="bg-blue-50 hover:bg-blue-100 dark:bg-slate-700 dark:hover:bg-slate-600 text-blue-700 dark:text-blue-300 font-bold px-3 py-1.5 rounded-lg text-[11px] transition inline-flex items-center gap-1 border border-blue-100 dark:border-slate-600">
                                <i class="fa-solid fa-pen text-[10px]"></i> Editar
                            </button>
                            <% if (a.cuenta_activa !== null && a.cuenta_activa !== undefined && !a.activation_token) { %>
                            <form method="POST" action="/backoffice/alumnos/<%= a.id %>/acceso" class="inline" onsubmit="return confirm('<%= a.cuenta_activa === 1 ? '¿Bloquear el acceso de este alumno al portal?' : '¿Habilitar nuevamente el acceso?' %>')">
                                <button type="submit" class="bg-slate-100 hover:bg-slate-200 dark:bg-slate-700 dark:hover:bg-slate-600 <%= a.cuenta_activa === 1 ? 'text-amber-700 dark:text-amber-300' : 'text-emerald-700 dark:text-emerald-300' %> font-bold px-3 py-1.5 rounded-lg text-[11px] transition inline-flex items-center gap-1 border border-slate-200 dark:border-slate-600" title="<%= a.cuenta_activa === 1 ? 'Impedir que ingrese al portal' : 'Permitirle ingresar otra vez' %>">
                                    <i class="fa-solid <%= a.cuenta_activa === 1 ? 'fa-lock' : 'fa-lock-open' %> text-[10px]"></i> <%= a.cuenta_activa === 1 ? 'Bloquear' : 'Habilitar' %>
                                </button>
                            </form>
                            <% } %>
                            <form method="POST" action="/backoffice/alumnos/<%= a.id %>/activar" class="inline">
                                <button type="submit" class="bg-slate-100 hover:bg-blue-50 dark:bg-slate-700 dark:hover:bg-slate-600 text-blue-700 dark:text-blue-300 font-bold px-3 py-1.5 rounded-lg text-[11px] transition inline-flex items-center gap-1 border border-slate-200 dark:border-slate-600" title="Generar un nuevo enlace de activación">
                                    <i class="fa-solid fa-key text-[10px]"></i> Enlace
                                </button>
                            </form>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Modal Registrar Nuevo Alumno -->
    <div id="nuevoAlumnoModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm fade-in">
        <div class="bg-white dark:bg-slate-800 rounded-3xl shadow-2xl border border-slate-200 dark:border-slate-700 max-w-lg w-full p-6 scale-in relative dark:text-slate-100">
            <div class="flex items-center justify-between pb-4 border-b border-slate-100 dark:border-slate-700 mb-4">
                <div class="flex items-center gap-2">
                    <div class="w-8 h-8 rounded-lg bg-blue-100 dark:bg-blue-900 text-blue-700 dark:text-blue-300 flex items-center justify-center font-bold">
                        <i class="fa-solid fa-user-plus"></i>
                    </div>
                    <h3 class="font-extrabold text-slate-800 dark:text-white text-base">Registrar Nuevo Alumno</h3>
                </div>
                <button onclick="closeNuevoAlumnoModal()" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>

            <form action="/backoffice/alumnos/nuevo" method="POST" class="space-y-4">
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">Legajo <span class="text-red-500 dark:text-red-400">*</span></label>
                        <input type="text" name="legajo" required placeholder="Ej: 2025-042" class="w-full text-xs px-3 py-2 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-600 dark:text-white dark:placeholder-slate-400 dark:focus:bg-slate-800">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">DNI <span class="text-red-500 dark:text-red-400">*</span></label>
                        <input type="text" name="dni" required placeholder="Sin puntos" class="w-full text-xs px-3 py-2 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-600 dark:text-white dark:placeholder-slate-400 dark:focus:bg-slate-800">
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">Nombre <span class="text-red-500 dark:text-red-400">*</span></label>
                        <input type="text" name="nombre" required placeholder="Nombre/s" class="w-full text-xs px-3 py-2 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-600 dark:text-white dark:placeholder-slate-400 dark:focus:bg-slate-800">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">Apellido <span class="text-red-500 dark:text-red-400">*</span></label>
                        <input type="text" name="apellido" required placeholder="Apellido/s" class="w-full text-xs px-3 py-2 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-600 dark:text-white dark:placeholder-slate-400 dark:focus:bg-slate-800">
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">Email Oficial <span class="text-red-500 dark:text-red-400">*</span></label>
                        <input type="email" name="email" required placeholder="alumno@email.com" class="w-full text-xs px-3 py-2 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-600 dark:text-white dark:placeholder-slate-400 dark:focus:bg-slate-800">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">Teléfono</label>
                        <input type="text" name="telefono" placeholder="Ej: 11-5555-1234" class="w-full text-xs px-3 py-2 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-600 dark:text-white dark:placeholder-slate-400 dark:focus:bg-slate-800">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">Carrera Inicial</label>
                    <select name="carrera_id" class="w-full text-xs px-3 py-2 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-600 dark:text-white dark:placeholder-slate-400 dark:focus:bg-slate-800">
                        <option value="">-- Sin carrera asignada --</option>
                        <% if (typeof carreras !== 'undefined') { %>
                            <% carreras.forEach(car => { %>
                            <option value="<%= car.id %>"><%= car.nombre %></option>
                            <% }) %>
                        <% } %>
                    </select>
                </div>

                <div class="pt-4 border-t border-slate-100 dark:border-slate-700 flex justify-end gap-2">
                    <button type="button" onclick="closeNuevoAlumnoModal()" class="px-4 py-2 rounded-xl text-xs font-bold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 transition">
                        Cancelar
                    </button>
                    <button type="submit" class="bg-blue-700 hover:bg-blue-800 text-white font-bold px-5 py-2 rounded-xl text-xs transition flex items-center gap-1.5 shadow-sm">
                        <i class="fa-solid fa-save"></i> Guardar y Generar Activación
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Editar Alumno (se completa con los datos de la fila elegida) -->
<%
    const cmp = 'w-full text-xs px-3 py-2 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-600 dark:text-white dark:placeholder-slate-400 dark:focus:bg-slate-800';
    const lbl = 'block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1';
%>
<div id="editarAlumnoModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm">
    <div class="bg-white dark:bg-slate-800 rounded-3xl shadow-2xl border border-slate-200 dark:border-slate-700 max-w-lg w-full p-6 relative dark:text-slate-100 max-h-[92vh] overflow-y-auto">
        <div class="flex items-center justify-between pb-4 border-b border-slate-100 dark:border-slate-700 mb-4">
            <h3 class="font-extrabold text-slate-800 dark:text-white text-base flex items-center gap-2"><i class="fa-solid fa-user-pen text-blue-600 dark:text-blue-400"></i> Editar alumno</h3>
            <button type="button" onclick="cerrarEditarAlumno()" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200"><i class="fa-solid fa-xmark text-lg"></i></button>
        </div>
        <form id="formEditarAlumno" method="POST" class="space-y-4">
            <div class="grid grid-cols-2 gap-3">
                <div><label class="<%= lbl %>">Legajo *</label><input type="text" name="legajo" id="eaLegajo" required class="<%= cmp %>"></div>
                <div><label class="<%= lbl %>">DNI *</label><input type="text" name="dni" id="eaDni" required class="<%= cmp %>"></div>
                <div><label class="<%= lbl %>">Nombre *</label><input type="text" name="nombre" id="eaNombre" required class="<%= cmp %>"></div>
                <div><label class="<%= lbl %>">Apellido *</label><input type="text" name="apellido" id="eaApellido" required class="<%= cmp %>"></div>
                <div><label class="<%= lbl %>">Email</label><input type="email" name="email" id="eaEmail" class="<%= cmp %>"></div>
                <div><label class="<%= lbl %>">Teléfono</label><input type="text" name="telefono" id="eaTelefono" class="<%= cmp %>"></div>
            </div>
            <div><label class="<%= lbl %>">Dirección</label><input type="text" name="direccion" id="eaDireccion" class="<%= cmp %>"></div>
            <div>
                <label class="<%= lbl %>">Carreras en las que cursa</label>
                <div class="max-h-36 overflow-y-auto border border-slate-200 dark:border-slate-600 rounded-xl p-2 space-y-1">
                    <% todasCarreras.forEach(car => { %>
                    <label class="flex items-center gap-2 text-xs text-slate-700 dark:text-slate-200 px-1 py-0.5">
                        <input type="checkbox" name="carreras" value="<%= car.id %>" class="ea-carrera rounded text-blue-600">
                        <%= car.nombre %><% if (!car.activo) { %> <span class="text-[10px] text-slate-500 dark:text-slate-400">(oculta en el sitio)</span><% } %>
                    </label>
                    <% }) %>
                    <% if (todasCarreras.length === 0) { %><p class="text-[11px] text-slate-500 dark:text-slate-400 px-1">Todavía no hay carreras cargadas.</p><% } %>
                </div>
                <p class="text-[10px] text-slate-500 dark:text-slate-400 mt-1">Al desmarcar una carrera el alumno deja de cursarla, pero se conserva su historial.</p>
            </div>
            <div class="pt-4 border-t border-slate-100 dark:border-slate-700 flex items-center justify-between gap-2">
                <button type="button" id="eaBaja" class="text-red-600 dark:text-red-400 hover:underline text-xs font-bold flex items-center gap-1"><i class="fa-solid fa-user-xmark"></i> Dar de baja</button>
                <div class="flex gap-2">
                    <button type="button" onclick="cerrarEditarAlumno()" class="px-4 py-2 rounded-xl text-xs font-bold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 transition">Cancelar</button>
                    <button type="submit" class="bg-blue-700 hover:bg-blue-800 text-white font-bold px-5 py-2 rounded-xl text-xs transition shadow-sm">Guardar cambios</button>
                </div>
            </div>
        </form>
        <form id="formBajaAlumno" method="POST" class="hidden"></form>
        <p id="eaAvisoBaja" class="hidden mt-3 text-[11px] text-amber-700 dark:text-amber-300 bg-amber-50 dark:bg-amber-900/30 border border-amber-200 dark:border-amber-800 rounded-lg p-2"></p>
    </div>
</div>

<script>
function abrirEditarAlumno(boton) {
    const a = JSON.parse(boton.dataset.alumno);
    document.getElementById('formEditarAlumno').action = '/backoffice/alumnos/' + a.id + '/editar';
    document.getElementById('formBajaAlumno').action = '/backoffice/alumnos/' + a.id + '/eliminar';
    const poner = (id, v) => { document.getElementById(id).value = v || ''; };
    poner('eaLegajo', a.legajo); poner('eaDni', a.dni); poner('eaNombre', a.nombre); poner('eaApellido', a.apellido);
    poner('eaEmail', a.email); poner('eaTelefono', a.telefono); poner('eaDireccion', a.direccion);
    document.querySelectorAll('.ea-carrera').forEach(function (c) { c.checked = a.carreras.indexOf(Number(c.value)) !== -1; });
    const baja = document.getElementById('eaBaja'), aviso = document.getElementById('eaAvisoBaja');
    if (a.historial > 0) {
        // Con solicitudes, cuotas o consultas no se borra: se bloquea el acceso desde la lista
        baja.classList.add('hidden');
        aviso.textContent = 'Este alumno tiene ' + a.historial + ' registro(s) (solicitudes, cuotas o consultas), por eso no se puede dar de baja. Para impedir su ingreso usá "Bloquear" en la lista.';
        aviso.classList.remove('hidden');
    } else {
        baja.classList.remove('hidden');
        aviso.classList.add('hidden');
        baja.onclick = function () { if (confirm('¿Dar de baja definitivamente a ' + a.apellido + ', ' + a.nombre + '? Esta acción no se puede deshacer.')) document.getElementById('formBajaAlumno').submit(); };
    }
    document.getElementById('editarAlumnoModal').classList.remove('hidden');
}
function cerrarEditarAlumno() { document.getElementById('editarAlumnoModal').classList.add('hidden'); }

function openNuevoAlumnoModal() {
    document.getElementById('nuevoAlumnoModal').classList.remove('hidden');
}
function closeNuevoAlumnoModal() {
    document.getElementById('nuevoAlumnoModal').classList.add('hidden');
}
function copyActivationLink() {
    const input = document.getElementById('activationLinkInput');
    input.select();
    navigator.clipboard.writeText(input.value);
    const btn = document.getElementById('copyLinkBtn');
    btn.innerHTML = '<i class="fa-solid fa-check"></i> ¡Copiado!';
    setTimeout(() => {
        btn.innerHTML = '<i class="fa-regular fa-copy"></i> Copiar Enlace';
    }, 2500);
}
</script>

