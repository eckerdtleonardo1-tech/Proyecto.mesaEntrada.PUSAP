<%- include('../partials/header') %>

<div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-black text-slate-800 dark:text-white flex items-center gap-2">
                <i class="fa-solid fa-user-graduate text-blue-600"></i> Gestión de Alumnos
            </h1>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Padrón de estudiantes, carreras activas y estado de acceso al portal.</p>
        </div>
    </div>

    <!-- Buscador -->
    <div class="bg-white dark:bg-slate-800 p-4 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm">
        <form method="GET" action="/backoffice/alumnos" class="flex gap-2">
            <input type="text" name="search" value="<%= query.search || '' %>" placeholder="Buscar por Nombre, Apellido, DNI o Legajo..." class="flex-1 text-xs px-4 py-2.5 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-600 dark:text-white">
            <button type="submit" class="bg-blue-700 hover:bg-blue-800 text-white font-bold px-4 py-2.5 rounded-xl text-xs transition flex items-center gap-1.5 shadow-sm">
                <i class="fa-solid fa-magnifying-glass"></i> Buscar
            </button>
            <% if (query.search) { %>
            <a href="/backoffice/alumnos" class="bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 font-bold px-4 py-2.5 rounded-xl text-xs transition flex items-center">
                Limpiar
            </a>
            <% } %>
        </form>
    </div>

    <!-- Lista de Alumnos -->
    <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
                <thead class="bg-slate-50 dark:bg-slate-700/50 border-b border-slate-200 dark:border-slate-700 text-slate-500 dark:text-slate-400 uppercase font-bold tracking-wider">
                    <tr>
                        <th class="px-5 py-3.5">Legajo / DNI</th>
                        <th class="px-5 py-3.5">Alumno</th>
                        <th class="px-5 py-3.5">Carrera(s)</th>
                        <th class="px-5 py-3.5">Contacto</th>
                        <th class="px-5 py-3.5 text-center">Acceso Portal</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-700/50">
                    <% if (alumnos.length === 0) { %>
                    <tr>
                        <td colspan="5" class="px-5 py-8 text-center text-slate-400">No se encontraron alumnos registrados.</td>
                    </tr>
                    <% } %>
                    <% alumnos.forEach(a => { %>
                    <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/40 transition">
                        <td class="px-5 py-3.5">
                            <span class="font-mono font-bold text-blue-700 dark:text-blue-400 block"><%= a.legajo %></span>
                            <span class="text-[11px] text-slate-400">DNI <%= a.dni %></span>
                        </td>
                        <td class="px-5 py-3.5 font-bold text-slate-800 dark:text-slate-100">
                            <%= a.apellido %>, <%= a.nombre %>
                        </td>
                        <td class="px-5 py-3.5 text-slate-600 dark:text-slate-300">
                            <%= a.carreras || '<span class="text-slate-400 italic">Sin carreras</span>' %>
                        </td>
                        <td class="px-5 py-3.5 text-slate-500 dark:text-slate-400">
                            <p><%= a.email || '-' %></p>
                            <p class="text-[10px]"><%= a.telefono || '' %></p>
                        </td>
                        <td class="px-5 py-3.5 text-center">
                            <% if (a.cuenta_activa === 1) { %>
                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10px] font-bold bg-green-100 text-green-800 dark:bg-green-950/40 dark:text-green-300 border border-green-200 dark:border-green-800">
                                <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span> Activo
                            </span>
                            <% } else if (a.cuenta_activa === 0) { %>
                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800 dark:bg-amber-950/40 dark:text-amber-300 border border-amber-200 dark:border-amber-800">
                                Pendiente activación
                            </span>
                            <% } else { %>
                            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[10px] font-bold bg-slate-100 text-slate-600 dark:bg-slate-700 dark:text-slate-300">
                                Sin usuario
                            </span>
                            <% } %>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
